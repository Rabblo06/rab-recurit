diff --git a/dist/cjs/client.js b/dist/cjs/client.js
index 8e3cf9abd9e7381d524150b6eded7f88d391daf3..a7fd6d7e695073436c87326c1d08e9f19b321502 100644
--- a/dist/cjs/client.js
+++ b/dist/cjs/client.js
@@ -4009,6 +4009,21 @@ class ExitAnimationFeature extends Feature {
         if (register) {
             this.unmount = register(this.id);
         }
+        /**
+         * Crewflow patch (backport of the upstream fix, framer-motion #4049): an
+         * element can mount already exiting, e.g. when AnimatePresence commits a
+         * child queued by onExitComplete after the render that removed it. update()
+         * compares against the previous presence context, which is also not
+         * present, so it would never start the exit and AnimatePresence would wait
+         * on this child forever. Start its exit on mount instead.
+         */
+        const { isPresent, onExitComplete } = this.node.presenceContext || {};
+        if (isPresent === false && this.node.animationState) {
+            const exitAnimation = this.node.animationState.setActive("exit", true);
+            if (onExitComplete) {
+                exitAnimation.then(() => onExitComplete(this.id));
+            }
+        }
     }
     unmount() { }
 }
