{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "packages/rab-docker/rab/Dockerfile",
    "dockerBuildTarget": "rab"
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "startCommand": "node packages/rab-server/dist/database/typeorm/scripts/setup-db.js && node packages/rab-server/dist/main",
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 300
  }
}
