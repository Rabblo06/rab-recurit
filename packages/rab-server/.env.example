NODE_ENV=development
PORT=3000
# Required by every migration and CLI command (database-target.ts). No default. For a local database: DB_TARGET=local.
# Production needs DB_TARGET=production AND ALLOW_PRODUCTION_DB_COMMANDS=true set in the DEPLOYMENT environment, not in this file.
# Never copy a Neon or other remote URL into a local .env: DATABASE_URL and DATABASE_URL_UNPOOLED must both be loopback or docker-service.
DB_TARGET=local
# P1C.2 (single-credential migration): ONE application login, `crewflow`, for ordinary API/Worker
# runtime, every CLI command, and workspace schema provisioning. It owns every ordinary tenant
# table (all carry FORCE ROW LEVEL SECURITY, so ownership never bypasses them) but deliberately
# does NOT own the ~11 pre-auth-sensitive tables (core.user, user_session, refresh_token,
# organisation, platform_admin, ...) or the SECURITY DEFINER functions that read them pre-context
# — those stay owned by a separate, NOLOGIN `rab_secure_owner` role that `crewflow` can never
# become (see docs/P1-MASTER-EXECUTION-STATUS.md's P1C.2 entry and docs/HANDOFF.md §42 for the full
# design and the real empirical test that proved it's necessary). `rab_app`/`rab_owner` are
# retired — NOLOGIN, zero remaining grants, kept only so nothing depending on their mere existence
# breaks outright.
DATABASE_URL=postgres://crewflow:crewflow_dev_only@localhost:5432/rab
# Same role (`crewflow`), same database — kept as a DISTINCT variable only because the worker's
# own advisory-lock-needing jobs (report generation, timesheet scheduling) require a genuinely
# direct, non-pooled connection, not because this is a different privilege tier any more. Actual
# schema/role DDL (migrations, the one-time role bootstrap itself) runs via a SEPARATE, privileged,
# migration-invocation-only identity that is NEVER placed in this file or any deployed container's
# environment — see the migration runbook referenced from docs/P1-MASTER-EXECUTION-STATUS.md.
DATABASE_URL_UNPOOLED=
REDIS_URL=redis://localhost:6379
# Redis checkpoint — P1E AuthSecuritySnapshot cache and the Twenty-style UserSession cache.
# Owner-approved default-on after each one's dedicated revocation/concurrency/fallback exit gate
# passed (see environment-variables.ts for the full evidence). Both are independent read-through
# accelerators only — PostgreSQL remains sole authority for revocation, idle/absolute expiry,
# roles and permissions either way; set either back to false to fall back to pre-cache behaviour
# with no data migration needed.
AUTH_CONTEXT_CACHE_ENABLED=true
USER_SESSION_CACHE_ENABLED=true
# openssl rand -hex 32
APP_SECRET=
# Checkpoint 3 — optional versioned keyrings (SecretEncryptionService / AccessTokenService). Leave
# both pairs unset for the default behaviour: exactly one implicit "legacy" key derived from
# APP_SECRET, identical to how this app behaved before these existed. Only set them to rotate a
# key — see docs for the rotation procedure. Deliberately two SEPARATE keyrings: an encryption key
# compromised in one role must never also be a live JWT-signing key, or vice versa.
# JSON array, e.g. [{"kid":"2026-11","secret":"<32+ random chars>"}]; ACTIVE_KID selects which
# entry new writes/tokens use. Required together — set neither, or set both.
APP_ENCRYPTION_KEYRING=
APP_ENCRYPTION_ACTIVE_KID=
APP_JWT_SIGNING_KEYRING=
APP_JWT_ACTIVE_KID=
# Wave 1 (B2) / wave 2 (A2): keep verifying access tokens under APP_SECRET-rooted kids this process no longer signs
# with: "legacy" (raw APP_SECRET, also kid-less tokens) and, once a keyring is active, "derived-v1". Since wave 2 new
# tokens are never signed with raw APP_SECRET (no keyring => kid "derived-v1" = HKDF(APP_SECRET, purpose label)). Set to
# false one access-token TTL (15 min) after the deploy that changed the signing kid.
APP_JWT_LEGACY_VERIFY_ENABLED=true
# Wave 2 (A2) key separation. Dedicated 32+ char secret for the auth-context cache HMAC (openssl rand -base64 48). Unset:
# HKDF-derived from APP_SECRET under its own purpose label. Must not equal APP_SECRET or any keyring secret (boot refuses).
APP_AUTH_CACHE_HMAC_KEY=
# true = refuse to boot unless APP_JWT_SIGNING_KEYRING/ACTIVE_KID, APP_JWT_LEGACY_VERIFY_ENABLED=false and
# APP_AUTH_CACHE_HMAC_KEY are all set (APP_SECRET is then no root of any JWT or cache-MAC key). Owner decision.
APP_KEY_SEPARATION_REQUIRED=false
# Wave 2 (A2, B3): __Host- prefixed browser auth cookies (Secure, Path=/, no Domain). Default off (identical to today).
# Needs an https API origin. LEGACY_MIGRATION (only read when the prefix is on) lets /auth/refresh rotate a pre-switch
# rab_rt / crewflow_session into the __Host- names once instead of forcing a re-login.
AUTH_COOKIE_HOST_PREFIX_ENABLED=false
AUTH_COOKIE_LEGACY_MIGRATION_ENABLED=true
SENTRY_DSN=
CORS_ORIGINS=http://localhost:5173

# Email — driver-based, vendor-agnostic (see engine/core-modules/email).
# LOGGER (default) just logs the email content, nothing sends — safe for
# local dev with no config. EMAIL_DRIVER=SMTP sends via any SMTP provider
# using the EMAIL_SMTP_* vars below. EMAIL_DRIVER=RESEND sends via Resend's
# API using RESEND_API_KEY — Resend requires EMAIL_FROM_ADDRESS to be on a
# domain verified in the Resend dashboard (SPF/DKIM); it cannot be an
# arbitrary third-party mailbox (e.g. a personal Gmail address) — use
# EMAIL_REPLY_TO for that instead.
EMAIL_DRIVER=LOGGER
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_NO_TLS=false
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=rab <no-reply@example.com>
EMAIL_REPLY_TO=
# Authenticated Manager web app's own domain — used only for the absolute
# "Continue to Manager Portal" link returned after activation/password-reset
# (no longer for the email links themselves, see ACCOUNTS_URL below).
APP_URL=http://localhost:5173
# Public, pre-authentication account pages (activate-account, reset-password,
# forgot-password) — deliberately a separate domain from APP_URL in
# production (e.g. https://accounts.rabworkspaceteams.co.uk vs
# https://app.rabworkspaceteams.co.uk) so these links never look like part of
# the authenticated Manager app. Same local dev server as APP_URL by default
# since there's only one Vite dev server locally.
ACCOUNTS_URL=http://localhost:5173
# host[:port] a workspace's subdomain is previewed against (CreateWorkspaceScreen, Settings →
# Domains) — presentation only while WORKSPACE_HOST_ROUTING_ENABLED / WORKSPACE_SUBDOMAIN_ORIGIN_TRUST_ENABLED are false (below). Chrome/Firefox resolve any *.localhost
# subdomain to loopback automatically (RFC 6761), so this works locally with no hosts-file edit.
# Leave unset to have the UI honestly show the current browser origin instead of a subdomain
# preview (see WORKSPACE_BASE_DOMAIN's own doc comment in environment-variables.ts). Production
# sets this to the real wildcard-DNS base domain.
WORKSPACE_BASE_DOMAIN=localhost:5173
# Wave 3 (lane H): workspace host routing. When true, the API resolves which workspace a browser is
# addressing (Host / X-Forwarded-Host from a TRUSTED_PROXY_CIDRS peer only / the browser Origin) against
# the database registry (READY, active, organisation not suspended): GET /rest/v1/public/workspace-host
# answers default / workspace / renamed / not-found, an authenticated request from another workspace's
# host gets a 404 (no disclosure), and workspace-specific email links use the canonical host. The host is
# routing context only - never authorisation. Requires WORKSPACE_BASE_DOMAIN (bare host[:port]).
WORKSPACE_HOST_ROUTING_ENABLED=false
# Wave 1 (D-C1) + wave 3: when true, CORS / cookie-CSRF also trust <scheme>://<label>.<WORKSPACE_BASE_DOMAIN>,
# but ONLY the exact canonical origin of a registered READY workspace (registry lookup, cached and invalidated
# on rename/READY/suspension). Unknown, reserved (api/admin/mail/...), xn--, renamed/quarantined labels, other
# ports and http-in-production are never trusted. Requires WORKSPACE_HOST_ROUTING_ENABLED=true (boot refused).
WORKSPACE_SUBDOMAIN_ORIGIN_TRUST_ENABLED=false
# Local *.localhost testing (http://<label>.localhost:5173): set both flags true, WORKSPACE_BASE_DOMAIN=localhost:5173,
# and run the front with VITE_API_URL=/rest/v1 + VITE_API_PROXY_TARGET=http://localhost:3000 (same-origin proxy, so the
# SameSite=Lax session cookie works on the workspace host). See WAVE3_LANE_H_REPORT.md section 6.

# First-Platform-Admin bootstrap (see command/bootstrap-admin.command.ts).
# Runs automatically on every boot, but no-ops instantly unless this is set
# AND zero active Platform Admins already exist — this is NOT a login
# backdoor, only a one-time seed for a fresh deployment. Leave blank for
# local dev; set in Render only for the very first deploy against a
# brand-new database. P2.9A: email-only — no password is configured here.
# A brand-new admin account is created pending activation and emailed a
# single-use activation link (the same /auth/activate-account flow every
# other invited account uses); it cannot log in until that link is used.
# Run it with DATABASE_URL set to the `crewflow` operator identity (never
# crewflow_app, which is refused); no superuser is needed. One-time: once any
# platform admin has existed it never creates another (foundation fix P2).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_FIRST_NAME=
BOOTSTRAP_ADMIN_LAST_NAME=
# Optional overrides for the organisation the bootstrap admin's own
# workspace is created under — leave blank to accept bootstrap-admin.
# command.ts's own generated defaults.
BOOTSTRAP_ADMIN_ORG_SLUG=
BOOTSTRAP_ADMIN_ORG_NAME=

# Attendance clock-in/out — all optional, defaults shown (see
# engine/core-modules/environment/environment-variables.ts).
CLOCK_IN_EARLY_MINUTES=15
QR_POST_SHIFT_GRACE_MINUTES=120
REPORT_AVAILABLE_BEFORE_MINUTES=180
GEOFENCE_MAX_ACCURACY_M=100
# Check In / Clock In / Clock Out location fixes at geofence-enforcing venues: max age and tolerated device-clock skew.
LOCATION_EVIDENCE_MAX_AGE_SECONDS=120
LOCATION_EVIDENCE_MAX_FUTURE_SKEW_SECONDS=30

# rab-worker automation timing — all optional, defaults shown (same
# validated EnvironmentVariables class the API uses; the worker reads the
# identical env). Grace/timeout windows for the late-clock-in and
# manager-confirmation-timeout detection jobs, and the retention window
# before a soft-deleted image becomes eligible for the storage-cleanup job.
LATE_CLOCK_IN_GRACE_MINUTES=10
MANAGER_CONFIRMATION_TIMEOUT_MINUTES=60
STORAGE_CLEANUP_PURGE_DELETED_IMAGES_AFTER_DAYS=30

# Object storage — driver-based (see engine/core-modules/storage). LOCAL
# (default) writes to STORAGE_LOCAL_ROOT on this process's own disk — fine
# for local dev, WRONG for anywhere API and Worker run as separate
# containers/instances (they'd each have their own disk). S3 uses any
# S3-compatible object store; production uses Cloudflare R2. STORAGE_DRIVER=S3
# refuses to boot unless S3_BUCKET/S3_REGION/S3_ACCESS_KEY_ID/
# S3_SECRET_ACCESS_KEY/S3_ENDPOINT are ALL set.
STORAGE_DRIVER=LOCAL
STORAGE_LOCAL_ROOT=./storage
# First path segment of every object key (e.g. production/staging/dev) so
# environments can share one bucket safely. Never authorization.
STORAGE_KEY_PREFIX=dev

# Required when STORAGE_DRIVER=S3. For Cloudflare R2: S3_REGION=auto,
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com,
# S3_FORCE_PATH_STYLE=true, S3_SERVER_SIDE_ENCRYPTION=NONE (R2 encrypts at
# rest automatically and rejects AWS's SSE request headers — do not set
# AES256/aws:kms for R2). Never commit real values here.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=true
S3_SERVER_SIDE_ENCRYPTION=NONE
# Only used if S3_SERVER_SIDE_ENCRYPTION=aws:kms (real AWS S3, not R2).
S3_KMS_KEY_ID=
# Presigned-URL lifetime in seconds (30-900). A URL is a bearer token for one object — keep it short.
S3_SIGNED_URL_TTL_SECONDS=120
# Hard ceiling for any single stored object, in bytes. Per-file-kind limits (avatar/logo/PDF) are lower still.
S3_MAX_UPLOAD_BYTES=20971520

# P1C.1B — system-level auth-provider toggles. Effective availability per request is always
# AUTH_<PROVIDER>_ENABLED AND the organisation's own <provider>_auth_enabled column — see
# docs/architecture/FULL-ARCHITECTURE-UPGRADE-PLAN.md §33.7. At least one of the three must be
# true or the process refuses to boot. Google/Microsoft CLIENT_ID/CLIENT_SECRET/CALLBACK_URL are
# required only when their own ENABLED flag is true.
AUTH_PASSWORD_ENABLED=true
# Wave 1 (D-A1): password sign-in attempt limits (Redis token buckets; they slow down, never hard-lock).
# Per (email, client IP): a burst, refilling over the window, plus a 24 h ceiling.
AUTH_LOGIN_EMAIL_IP_BURST=5
AUTH_LOGIN_EMAIL_IP_WINDOW_SECONDS=900
AUTH_LOGIN_EMAIL_IP_DAILY_LIMIT=30
# Account-wide across all IPs, applied only to addresses that have not signed in to the account in the last N days.
AUTH_LOGIN_ACCOUNT_BURST=50
AUTH_LOGIN_ACCOUNT_WINDOW_SECONDS=900
AUTH_LOGIN_KNOWN_IP_TTL_DAYS=30
# Wave 4 (MFA): TOTP second factor. Any web user may enrol; an enrolled user is ALWAYS challenged on web sign-in.
# Enforcement (enrolment required at next sign-in, never a lockout) per class — all OFF by default; turn on in stages
# (WAVE4_LANE_MFA_REPORT.md §rollout): platform admin → organisation owner (ceo) → Initial Manager → other web users.
AUTH_MFA_ENROLMENT_ENABLED=true
AUTH_MFA_ENFORCE_PLATFORM_ADMIN=false
AUTH_MFA_ENFORCE_ORGANISATION_OWNER=false
AUTH_MFA_ENFORCE_INITIAL_MANAGER=false
AUTH_MFA_ENFORCE_OTHER_WEB_USERS=false
# exempt = mobile-app sign-ins are never challenged (the apps have no code screen yet); require = they are.
AUTH_MFA_MOBILE_POLICY=exempt
AUTH_MFA_CHALLENGE_TTL_SECONDS=300
AUTH_MFA_CHALLENGE_MAX_ATTEMPTS=5
# Per user, across IPs and challenges (step-up / disable included): a burst, refilling over the window.
AUTH_MFA_USER_ATTEMPTS_BURST=10
AUTH_MFA_USER_ATTEMPTS_WINDOW_SECONDS=900
AUTH_MFA_ISSUER=Crewflow
# Reusable step-up grant (POST /auth/step-up) lifetime; and whether the older password-only step-up actions also demand
# a code from enrolled actors (keep false until their dialogs have a code field).
AUTH_STEP_UP_WINDOW_SECONDS=300
AUTH_STEP_UP_MFA_FOR_LEGACY_ACTIONS=false
# Cross-host login handoff (default host → the user's own workspace host). Requires WORKSPACE_HOST_ROUTING_ENABLED=true
# and WORKSPACE_SUBDOMAIN_ORIGIN_TRUST_ENABLED=true. TTL 10..60 s.
AUTH_LOGIN_HANDOFF_ENABLED=false
AUTH_LOGIN_HANDOFF_TTL_SECONDS=30
AUTH_GOOGLE_ENABLED=false
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_CALLBACK_URL=http://localhost:3000/rest/v1/auth/google/callback
AUTH_MICROSOFT_ENABLED=false
AUTH_MICROSOFT_CLIENT_ID=
AUTH_MICROSOFT_CLIENT_SECRET=
AUTH_MICROSOFT_CALLBACK_URL=http://localhost:3000/rest/v1/auth/microsoft/callback
# Fixed to Azure AD work/school accounts only — deliberately not Twenty's own 'common' default
# (which also accepts unmanaged personal Microsoft accounts). Not a free-form override; changing
# this requires a code change, not a config change.
AUTH_MICROSOFT_TENANT=organizations

# Stage 6 — durable push delivery. Disabled by default: when false, PushDeliveryService never
# creates a push_delivery row at all. PUSH_PROVIDER=FAKE (default) needs no credentials and is what
# every ordinary test and local dev run uses. PUSH_PROVIDER=REAL routes android devices to FCM and
# ios devices to direct Apple APNs (never through Firebase) — never require either credential set
# to run ordinary backend unit tests, and never put real values here.
PUSH_ENABLED=false
PUSH_PROVIDER=FAKE
PUSH_DELIVERY_MAX_ATTEMPTS=5
# Required only when PUSH_PROVIDER=REAL and an android device exists. The Firebase service-account
# JSON as a single-line string. Unset falls back to application-default credentials (workload
# identity) rather than failing.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Required only when PUSH_PROVIDER=REAL and an ios device exists (Apple's HTTP/2 Provider API,
# JWT ES256 provider-token auth — a direct APNs integration, not Firebase).
APNS_AUTH_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
# sandbox (default) talks to api.sandbox.push.apple.com — matches development-signed app builds.
APNS_ENVIRONMENT=sandbox

# Wave 5 lane OPS — in-process L1 for NON-AUTHORISATION metadata only (workspace -> schema, host label -> workspace,
# static permission catalogue), in front of the Redis caches above. Never sessions, auth contexts or per-user permissions.
# Only active for a kind whose own Redis cache flag is on, and only while this process holds its Redis invalidation
# subscription (Redis down = exactly the old behaviour). Off by default; enable per environment after the load test.
METADATA_L1_CACHE_ENABLED=false
METADATA_L1_CACHE_TTL_MS=2000
METADATA_L1_CACHE_MAX_ENTRIES=5000
METADATA_L1_CACHE_MAX_BYTES=8388608

# Wave 5 lane OPS (G6) — terminal outbox/event retention. OWNER DECISION PENDING on the periods: OFF by default.
# When enabled it starts in `report` mode (counts only, zero deletes); `purge` deletes TERMINAL rows older than the period
# through DB5's core.purge_terminal_* functions. The day values below are SUGGESTIONS, not decisions; the validator (and
# the database) refuse email/push/worker_event < 30 and realtime < 7.
OUTBOX_RETENTION_ENABLED=false
OUTBOX_RETENTION_MODE=report
OUTBOX_RETENTION_EMAIL_DAYS=90
OUTBOX_RETENTION_PUSH_DAYS=30
OUTBOX_RETENTION_REALTIME_DAYS=7
OUTBOX_RETENTION_WORKER_EVENT_DAYS=30
OUTBOX_RETENTION_BATCH_SIZE=1000
OUTBOX_RETENTION_MAX_BATCHES_PER_SCOPE=20
OUTBOX_RETENTION_INTERVAL_MINUTES=60

# Wave 4/5 (MFA-lane request) — purge of cross-host login handoffs (rows expired/consumed > 1 h ago) via DB5's
# core.login_handoff_cleanup. ON by default: short-lived security tokens, not business records.
LOGIN_HANDOFF_CLEANUP_ENABLED=true
LOGIN_HANDOFF_CLEANUP_INTERVAL_MINUTES=15

# BullMQ worker migration (Lane A) — how the Worker's jobs process schedules its 19 periodic scans.
# interval (default): every replica runs every loop on its own timer (the historical behaviour).
# bullmq: one cluster-wide BullMQ job scheduler per scan; one replica runs each tick (per-scan advisory lock).
#         Requires Redis maxmemory-policy=noeviction (the worker refuses to boot otherwise).
WORKER_SCHEDULER=interval
# Key prefix for the NEW scan queues only (default crewflow:<NODE_ENV>:bull). rab-email / rab-push /
# rab-shift-statements always stay on BullMQ's default "bull" prefix (the API publishes to them); "bull" is refused here.
# BULLMQ_PREFIX=crewflow:development:bull
# bullmq mode: seconds between idempotent scheduler reconciles (recreates schedulers lost to a Redis restart/flush).
WORKER_SCHEDULER_RECONCILE_SECONDS=60

# AI (docs/ai/PHASE1_PLAN.md, PART_A_PLAN.md, PHASE1_TWENTY_PLAN.md). Every value below is an initial design default, not
# a statement of provider capacity or price. "Real models only": the facts are in the code catalogue
# (packages/rab-server/src/engine/core-modules/ai/models/ai-models.json); a model runs only when it is security-approved in
# code (catalog.ts), its SDK is in this build, its provider key is set, it is not disabled and the environment permits it.
# The model is chosen per organisation in Settings -> AI (the CEO), not here. There is no mock in the app (test-only).
# Misconfiguration leaves AI "not configured" (logged, Admin Panel) without stopping the API or Worker.
# Default ON (owner decision EX-2, 2026-10-25). AI still needs an organisation switch (default OFF) and an available model.
# Production sets AI_ENABLED=false explicitly in docker-compose.production.yml.
AI_ENABLED=true
# RETIRED: do not set AI_PROVIDER, AI_MODEL or AI_PROVIDER_API_KEY. A mock value refuses to boot outside tests; the old key
# alias refuses to boot in development and test (rename it ANTHROPIC_API_KEY); other values are ignored with a warning.
# A REAL model in DEVELOPMENT only, synthetic data only (EX-1). Before filling any of these, work through
# docs/ai/CREWFLOW_AI_RELEASE_CHECKLIST.md and the rab-docs page "How to add or rotate a provider key". Names only here:
# never put a key in this file or the repo. A real model also needs NODE_ENV=development, the development database
# (RAB_RUNTIME_ENV=development) and an organisation seeded by `seed-ai-demo`.
# Provider keys (secret; server + Worker only; shown as "configured" only in the Admin Panel). Only Anthropic's SDK is in
# this build; the other four names are inert until a model of theirs is approved and its SDK installed.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
# true only in development; boot refuses it under NODE_ENV=production or test.
AI_DEV_ALLOW_REAL_PROVIDERS=
# Estimated provider cost per organisation per UTC day, USD (empty = 2). Every model step reserves its worst case first.
AI_DAILY_BUDGET_USD=
# Comma-separated catalogue ids used when an organisation has not pinned a model: the first AVAILABLE id wins, then the
# other tier's list, then any available model. They cannot make an unapproved, keyless or disabled model run.
AI_MODELS_DEFAULT_FAST=
AI_MODELS_DEFAULT_SMART=
# Comma-separated catalogue ids nobody may use (hard deny).
AI_MODELS_DEFAULT_DISABLED=
AI_MAX_OUTPUT_TOKENS=1500
AI_MAX_STEPS=8
AI_MAX_INPUT_CHARS=4000
AI_ORG_DAILY_TOKEN_BUDGET=200000
# Phase 7b rate limits (owner decision 2026-10-25), one atomic Redis call: per user per minute, per organisation per
# minute, per user per UTC day. A user limit above the organisation's only warns.
AI_USER_RATE_PER_MIN=10
AI_ORG_RATE_PER_MIN=60
AI_USER_TURNS_PER_DAY=100
# Phase 7b: estimated provider cost per PERSON per UTC day, USD (empty = 1; PROVISIONAL default, owner to confirm).
# The effective ceiling is the lower of this and AI_DAILY_BUDGET_USD.
AI_USER_DAILY_BUDGET_USD=
AI_ORG_MAX_ACTIVE_TURNS=2
AI_TURN_TIMEOUT_SECONDS=90
AI_RETENTION_DAYS=90
# off (default) | report (counts only) | purge (deletes; owner enables after a report run)
AI_RETENTION_MODE=off
AI_RETENTION_INTERVAL_MINUTES=60
# Phase 2: a conversation's first question also asks the fast model for a short title (Worker, gateway, EX-1, budget).
# false = no title calls (the first-question text stays the title).
AI_TITLE_GENERATION=true
# Phase 6a: AI agents (Settings → AI → Agents). Storage only until the owner approves EX-3 — nothing runs. Default false;
# only the exact string true turns the API on. Production pins false.
AI_AGENTS_ENABLED=false

# Admin Panel → General. APP_VERSION is shown as the version; APP_GIT_COMMIT (optional, 7–40 lowercase hex) is the git
# commit the image was built from — set it at build/deploy time (e.g. a Docker build arg). Unset → "Unknown".
# APP_VERSION=0.3.0
# APP_GIT_COMMIT=efc4709
