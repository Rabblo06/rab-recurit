NODE_ENV=development
PORT=3000
# M0: rab_owner connection (runs migrations; owns the `core` schema and,
# after the bootstrap SQL runs, the database itself — see
# rab-workforce-architecture.md §5.7 and packages/rab-docker/postgres-init/).
# Used for both migrations and runtime for now. M1 must split this into a
# separate runtime connection as rab_app (NOBYPASSRLS) once the first RLS
# policy exists, so the running server never connects with owner privileges.
DATABASE_URL=postgres://rab_owner:rab_owner_dev_only@localhost:5432/rab
REDIS_URL=redis://localhost:6379
# openssl rand -hex 32
APP_SECRET=
SENTRY_DSN=
CORS_ORIGINS=http://localhost:5173

# Email — driver-based, vendor-agnostic (see engine/core-modules/email).
# LOGGER (default) just logs the email content, nothing sends — safe for
# local dev with no config. EMAIL_DRIVER=SMTP sends via any SMTP provider
# using the EMAIL_SMTP_* vars below. EMAIL_DRIVER=RESEND sends via Resend's
# API using RESEND_API_KEY — Resend requires EMAIL_FROM_ADDRESS to be on a
# domain verified in the Resend dashboard (SPF/DKIM); it cannot be an
# arbitrary third-party mailbox (e.g. a personal Gmail address) — use
# EMAIL_REPLY_TO for that instead.
EMAIL_DRIVER=LOGGER
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_NO_TLS=false
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=rab <no-reply@example.com>
EMAIL_REPLY_TO=
APP_URL=http://localhost:5173

# First-Platform-Admin bootstrap (see command/bootstrap-admin.command.ts).
# Runs automatically on every boot, but no-ops instantly unless BOTH of
# these are set AND zero active Platform Admins already exist — this is
# NOT a login backdoor, only a one-time seed for a fresh deployment. Leave
# both blank for local dev; set both in Render only for the very first
# deploy against a brand-new database, then remove BOOTSTRAP_ADMIN_PASSWORD
# once you've confirmed normal login works with the resulting account.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FIRST_NAME=
BOOTSTRAP_ADMIN_LAST_NAME=

# Attendance clock-in/out — all optional, defaults shown (see
# engine/core-modules/environment/environment-variables.ts).
CLOCK_IN_EARLY_MINUTES=15
QR_POST_SHIFT_GRACE_MINUTES=120
REPORT_AVAILABLE_BEFORE_MINUTES=180
GEOFENCE_MAX_ACCURACY_M=100

# Object storage — driver-based (see engine/core-modules/storage). LOCAL
# (default) writes to STORAGE_LOCAL_ROOT on this process's own disk — fine
# for local dev, WRONG for anywhere API and Worker run as separate
# containers/instances (they'd each have their own disk). S3 uses any
# S3-compatible object store; production uses Cloudflare R2. STORAGE_DRIVER=S3
# refuses to boot unless S3_BUCKET/S3_REGION/S3_ACCESS_KEY_ID/
# S3_SECRET_ACCESS_KEY/S3_ENDPOINT are ALL set.
STORAGE_DRIVER=LOCAL
STORAGE_LOCAL_ROOT=./storage
# First path segment of every object key (e.g. production/staging/dev) so
# environments can share one bucket safely. Never authorization.
STORAGE_KEY_PREFIX=dev

# Required when STORAGE_DRIVER=S3. For Cloudflare R2: S3_REGION=auto,
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com,
# S3_FORCE_PATH_STYLE=true, S3_SERVER_SIDE_ENCRYPTION=NONE (R2 encrypts at
# rest automatically and rejects AWS's SSE request headers — do not set
# AES256/aws:kms for R2). Never commit real values here.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=true
S3_SERVER_SIDE_ENCRYPTION=NONE
# Only used if S3_SERVER_SIDE_ENCRYPTION=aws:kms (real AWS S3, not R2).
S3_KMS_KEY_ID=
# Presigned-URL lifetime in seconds (30-900). A URL is a bearer token for one object — keep it short.
S3_SIGNED_URL_TTL_SECONDS=120
# Hard ceiling for any single stored object, in bytes. Per-file-kind limits (avatar/logo/PDF) are lower still.
S3_MAX_UPLOAD_BYTES=20971520
