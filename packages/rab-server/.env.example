NODE_ENV=development
PORT=3000
# Required by every migration and CLI command (database-target.ts). No default. For a local database: DB_TARGET=local.
# Production needs DB_TARGET=production AND ALLOW_PRODUCTION_DB_COMMANDS=true set in the DEPLOYMENT environment, not in this file.
# Never copy a Neon or other remote URL into a local .env: DATABASE_URL and DATABASE_URL_UNPOOLED must both be loopback or docker-service.
DB_TARGET=local
# P1C.2 (single-credential migration): ONE application login, `crewflow`, for ordinary API/Worker
# runtime, every CLI command, and workspace schema provisioning. It owns every ordinary tenant
# table (all carry FORCE ROW LEVEL SECURITY, so ownership never bypasses them) but deliberately
# does NOT own the ~11 pre-auth-sensitive tables (core.user, user_session, refresh_token,
# organisation, platform_admin, ...) or the SECURITY DEFINER functions that read them pre-context
# — those stay owned by a separate, NOLOGIN `rab_secure_owner` role that `crewflow` can never
# become (see docs/P1-MASTER-EXECUTION-STATUS.md's P1C.2 entry and docs/HANDOFF.md §42 for the full
# design and the real empirical test that proved it's necessary). `rab_app`/`rab_owner` are
# retired — NOLOGIN, zero remaining grants, kept only so nothing depending on their mere existence
# breaks outright.
DATABASE_URL=postgres://crewflow:crewflow_dev_only@localhost:5432/rab
# Same role (`crewflow`), same database — kept as a DISTINCT variable only because the worker's
# own advisory-lock-needing jobs (report generation, timesheet scheduling) require a genuinely
# direct, non-pooled connection, not because this is a different privilege tier any more. Actual
# schema/role DDL (migrations, the one-time role bootstrap itself) runs via a SEPARATE, privileged,
# migration-invocation-only identity that is NEVER placed in this file or any deployed container's
# environment — see the migration runbook referenced from docs/P1-MASTER-EXECUTION-STATUS.md.
DATABASE_URL_UNPOOLED=
REDIS_URL=redis://localhost:6379
# Redis checkpoint — P1E AuthSecuritySnapshot cache and the Twenty-style UserSession cache.
# Owner-approved default-on after each one's dedicated revocation/concurrency/fallback exit gate
# passed (see environment-variables.ts for the full evidence). Both are independent read-through
# accelerators only — PostgreSQL remains sole authority for revocation, idle/absolute expiry,
# roles and permissions either way; set either back to false to fall back to pre-cache behaviour
# with no data migration needed.
AUTH_CONTEXT_CACHE_ENABLED=true
USER_SESSION_CACHE_ENABLED=true
# openssl rand -hex 32
APP_SECRET=
# Checkpoint 3 — optional versioned keyrings (SecretEncryptionService / AccessTokenService). Leave
# both pairs unset for the default behaviour: exactly one implicit "legacy" key derived from
# APP_SECRET, identical to how this app behaved before these existed. Only set them to rotate a
# key — see docs for the rotation procedure. Deliberately two SEPARATE keyrings: an encryption key
# compromised in one role must never also be a live JWT-signing key, or vice versa.
# JSON array, e.g. [{"kid":"2026-11","secret":"<32+ random chars>"}]; ACTIVE_KID selects which
# entry new writes/tokens use. Required together — set neither, or set both.
APP_ENCRYPTION_KEYRING=
APP_ENCRYPTION_ACTIVE_KID=
APP_JWT_SIGNING_KEYRING=
APP_JWT_ACTIVE_KID=
SENTRY_DSN=
CORS_ORIGINS=http://localhost:5173

# Email — driver-based, vendor-agnostic (see engine/core-modules/email).
# LOGGER (default) just logs the email content, nothing sends — safe for
# local dev with no config. EMAIL_DRIVER=SMTP sends via any SMTP provider
# using the EMAIL_SMTP_* vars below. EMAIL_DRIVER=RESEND sends via Resend's
# API using RESEND_API_KEY — Resend requires EMAIL_FROM_ADDRESS to be on a
# domain verified in the Resend dashboard (SPF/DKIM); it cannot be an
# arbitrary third-party mailbox (e.g. a personal Gmail address) — use
# EMAIL_REPLY_TO for that instead.
EMAIL_DRIVER=LOGGER
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_NO_TLS=false
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=rab <no-reply@example.com>
EMAIL_REPLY_TO=
# Authenticated Manager web app's own domain — used only for the absolute
# "Continue to Manager Portal" link returned after activation/password-reset
# (no longer for the email links themselves, see ACCOUNTS_URL below).
APP_URL=http://localhost:5173
# Public, pre-authentication account pages (activate-account, reset-password,
# forgot-password) — deliberately a separate domain from APP_URL in
# production (e.g. https://accounts.rabworkspaceteams.co.uk vs
# https://app.rabworkspaceteams.co.uk) so these links never look like part of
# the authenticated Manager app. Same local dev server as APP_URL by default
# since there's only one Vite dev server locally.
ACCOUNTS_URL=http://localhost:5173
# host[:port] a workspace's subdomain is previewed against (CreateWorkspaceScreen, Settings →
# Domains) — presentation only, never auth-relevant. Chrome/Firefox resolve any *.localhost
# subdomain to loopback automatically (RFC 6761), so this works locally with no hosts-file edit.
# Leave unset to have the UI honestly show the current browser origin instead of a subdomain
# preview (see WORKSPACE_BASE_DOMAIN's own doc comment in environment-variables.ts). Production
# sets this to the real wildcard-DNS base domain.
WORKSPACE_BASE_DOMAIN=localhost:5173

# First-Platform-Admin bootstrap (see command/bootstrap-admin.command.ts).
# Runs automatically on every boot, but no-ops instantly unless this is set
# AND zero active Platform Admins already exist — this is NOT a login
# backdoor, only a one-time seed for a fresh deployment. Leave blank for
# local dev; set in Render only for the very first deploy against a
# brand-new database. P2.9A: email-only — no password is configured here.
# A brand-new admin account is created pending activation and emailed a
# single-use activation link (the same /auth/activate-account flow every
# other invited account uses); it cannot log in until that link is used.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_FIRST_NAME=
BOOTSTRAP_ADMIN_LAST_NAME=
# Optional overrides for the organisation the bootstrap admin's own
# workspace is created under — leave blank to accept bootstrap-admin.
# command.ts's own generated defaults.
BOOTSTRAP_ADMIN_ORG_SLUG=
BOOTSTRAP_ADMIN_ORG_NAME=

# Attendance clock-in/out — all optional, defaults shown (see
# engine/core-modules/environment/environment-variables.ts).
CLOCK_IN_EARLY_MINUTES=15
QR_POST_SHIFT_GRACE_MINUTES=120
REPORT_AVAILABLE_BEFORE_MINUTES=180
GEOFENCE_MAX_ACCURACY_M=100
# Check In / Clock In / Clock Out location fixes at geofence-enforcing venues: max age and tolerated device-clock skew.
LOCATION_EVIDENCE_MAX_AGE_SECONDS=120
LOCATION_EVIDENCE_MAX_FUTURE_SKEW_SECONDS=30

# rab-worker automation timing — all optional, defaults shown (same
# validated EnvironmentVariables class the API uses; the worker reads the
# identical env). Grace/timeout windows for the late-clock-in and
# manager-confirmation-timeout detection jobs, and the retention window
# before a soft-deleted image becomes eligible for the storage-cleanup job.
LATE_CLOCK_IN_GRACE_MINUTES=10
MANAGER_CONFIRMATION_TIMEOUT_MINUTES=60
STORAGE_CLEANUP_PURGE_DELETED_IMAGES_AFTER_DAYS=30

# Object storage — driver-based (see engine/core-modules/storage). LOCAL
# (default) writes to STORAGE_LOCAL_ROOT on this process's own disk — fine
# for local dev, WRONG for anywhere API and Worker run as separate
# containers/instances (they'd each have their own disk). S3 uses any
# S3-compatible object store; production uses Cloudflare R2. STORAGE_DRIVER=S3
# refuses to boot unless S3_BUCKET/S3_REGION/S3_ACCESS_KEY_ID/
# S3_SECRET_ACCESS_KEY/S3_ENDPOINT are ALL set.
STORAGE_DRIVER=LOCAL
STORAGE_LOCAL_ROOT=./storage
# First path segment of every object key (e.g. production/staging/dev) so
# environments can share one bucket safely. Never authorization.
STORAGE_KEY_PREFIX=dev

# Required when STORAGE_DRIVER=S3. For Cloudflare R2: S3_REGION=auto,
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com,
# S3_FORCE_PATH_STYLE=true, S3_SERVER_SIDE_ENCRYPTION=NONE (R2 encrypts at
# rest automatically and rejects AWS's SSE request headers — do not set
# AES256/aws:kms for R2). Never commit real values here.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=true
S3_SERVER_SIDE_ENCRYPTION=NONE
# Only used if S3_SERVER_SIDE_ENCRYPTION=aws:kms (real AWS S3, not R2).
S3_KMS_KEY_ID=
# Presigned-URL lifetime in seconds (30-900). A URL is a bearer token for one object — keep it short.
S3_SIGNED_URL_TTL_SECONDS=120
# Hard ceiling for any single stored object, in bytes. Per-file-kind limits (avatar/logo/PDF) are lower still.
S3_MAX_UPLOAD_BYTES=20971520

# P1C.1B — system-level auth-provider toggles. Effective availability per request is always
# AUTH_<PROVIDER>_ENABLED AND the organisation's own <provider>_auth_enabled column — see
# docs/architecture/FULL-ARCHITECTURE-UPGRADE-PLAN.md §33.7. At least one of the three must be
# true or the process refuses to boot. Google/Microsoft CLIENT_ID/CLIENT_SECRET/CALLBACK_URL are
# required only when their own ENABLED flag is true.
AUTH_PASSWORD_ENABLED=true
AUTH_GOOGLE_ENABLED=false
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_CALLBACK_URL=http://localhost:3000/rest/v1/auth/google/callback
AUTH_MICROSOFT_ENABLED=false
AUTH_MICROSOFT_CLIENT_ID=
AUTH_MICROSOFT_CLIENT_SECRET=
AUTH_MICROSOFT_CALLBACK_URL=http://localhost:3000/rest/v1/auth/microsoft/callback
# Fixed to Azure AD work/school accounts only — deliberately not Twenty's own 'common' default
# (which also accepts unmanaged personal Microsoft accounts). Not a free-form override; changing
# this requires a code change, not a config change.
AUTH_MICROSOFT_TENANT=organizations

# Stage 6 — durable push delivery. Disabled by default: when false, PushDeliveryService never
# creates a push_delivery row at all. PUSH_PROVIDER=FAKE (default) needs no credentials and is what
# every ordinary test and local dev run uses. PUSH_PROVIDER=REAL routes android devices to FCM and
# ios devices to direct Apple APNs (never through Firebase) — never require either credential set
# to run ordinary backend unit tests, and never put real values here.
PUSH_ENABLED=false
PUSH_PROVIDER=FAKE
PUSH_DELIVERY_MAX_ATTEMPTS=5
# Required only when PUSH_PROVIDER=REAL and an android device exists. The Firebase service-account
# JSON as a single-line string. Unset falls back to application-default credentials (workload
# identity) rather than failing.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Required only when PUSH_PROVIDER=REAL and an ios device exists (Apple's HTTP/2 Provider API,
# JWT ES256 provider-token auth — a direct APNs integration, not Firebase).
APNS_AUTH_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
# sandbox (default) talks to api.sandbox.push.apple.com — matches development-signed app builds.
APNS_ENVIRONMENT=sandbox
