{
  "name": "rab-ui",
  "sourceRoot": "packages/rab-ui/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/packages/rab-ui/dist-esm",
        "{workspaceRoot}/packages/rab-ui/dist-cjs"
      ],
      "options": {
        "commands": [
          "tsc -p packages/rab-ui/tsconfig.lib.json",
          "tsc -p packages/rab-ui/tsconfig.lib.cjs.json",
          "node -e \"require('fs').writeFileSync('packages/rab-ui/dist-cjs/package.json', JSON.stringify({type:'commonjs'}))\""
        ],
        "parallel": false
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p packages/rab-ui/tsconfig.lib.json"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/packages/rab-ui"],
      "options": {
        "jestConfig": "packages/rab-ui/jest.config.ts"
      }
    }
  },
  "tags": []
}
