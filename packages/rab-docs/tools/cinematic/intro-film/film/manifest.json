  "segments": {
    "c1-need": {
      "id": "c1-need",
      "start": 1.4,
      "end": 10.805,
      "seconds": 9.405,
      "text": "A venue needs a team for Friday. A manager needs to know who's booked. And staff need to know where to be, and what happens next.",
      "chapter": "Why Crewflow",
      "file": "C:\\Rab-recruit\\packages\\rab-docs\\tools\\narration\\build\\crewflow-introduction\\c1-need.wav"
    },
    "c1-connect": {
      "id": "c1-connect",
      "start": 11.505,
      "end": 16.774,
      "seconds": 5.269,
      "text": "Crewflow connects that whole journey, from the first request to the final timesheet.",
      "chapter": "Why Crewflow",
      "file": "C:\\Rab-recruit\\packages\\rab-docs\\tools\\narration\\build\\crewflow-introduction\\c1-connect.wav"
    },
    "c2-web": {
      "id": "c2-web",
      "start": 22.074,
      "end": 30.543,
      "seconds": 8.469,
      "text": "Managers run their agency from the web console. Each manager has a private workspace, with their own staff, venues and shifts.",
      "chapter": "Who uses it",
      "file": "C:\\Rab-recruit\\packages\\rab-docs\\tools\\narration\\build\\crewflow-introduction\\c2-web.wav"
    },
    "c2-mobile": {
      "id": "c2-mobile",
      "start": 31.143,
      "end": 39.566,
      "seconds": 8.423,
      "text": "Venue managers use the Crewflow app to request staff. Staff use the same app to see their offers, clock in, and check their hours.",
      "chapter": "Who uses it",
      "file": "C:\\Rab-recruit\\packages\\rab-docs\\tools\\narration\\build\\crewflow-introduction\\c2-mobile.wav"
    },
    "c3-records": {
      "id": "c3-records",
      "start": 42.466,
      "end": 49.624,
      "seconds": 7.158,
      "text": "It starts with the team. In the web console, the manager keeps a record for every staff member and every venue.",
      "chapter": "Build the team",
      "file": "C:\\Rab-recruit\\packages\\rab-docs\\tools\\narration\\build\\crewflow-introduction\\c3-records.wav"
    },
    "c3-assign": {
      "id": "c3-assign",
      "start": 50.224,
      "end": 56.368,
      "seconds": 6.144,
      "text": "Each venue manager is linked to a venue, and the manager decides which staff each one can work with.",
      "chapter": "Build the team",
      "file": "C:\\Rab-recruit\\packages\\rab-docs\\tools\\narration\\build\\crewflow-introduction\\c3-assign.wav"
    },
    "c3-riley": {
      "id": "c3-riley",
      "start": 56.868,
      "end": 60.857,
      "seconds": 3.989,
      "text": "Here, Riley Chen is the venue manager at Riverside House.",
      "chapter": "Build the team",
      "file": "C:\\Rab-recruit\\packages\\rab-docs\\tools\\narration\\build\\crewflow-introduction\\c3-riley.wav"
    },
    "c3-scope": {
      "id": "c3-scope",
      "start": 61.357,
      "end": 65.581,
      "seconds": 4.224,
      "text": "In the app, Riley sees that assigned team, and no one else.",
      "chapter": "Build the team",
      "file": "C:\\Rab-recruit\\packages\\rab-docs\\tools\\narration\\build\\crewflow-introduction\\c3-scope.wav"
    },
    "c4-need": {
      "id": "c4-need",
      "start": 68.881,
      "end": 73.87,
      "seconds": 4.989,
      "text": "On Tuesday, Riley needs four waiting staff for a wedding reception on Friday.",
      "chapter": "Request and approve",
      "file": "C:\\Rab-recruit\\packages\\rab-docs\\tools\\narration\\build\\crewflow-introduction\\c4-need.wav"
    },
    "c4-form": {
      "id": "c4-form",
      "start": 74.37,
      "end": 80.893,
      "seconds": 6.523,
      "text": "Riley chooses the venue, the role, the time and the break, then picks four people from the team.",
      "chapter": "Request and approve",
      "file": "C:\\Rab-recruit\\packages\\rab-docs\\tools\\narration\\build\\crewflow-introduction\\c4-form.wav"
    },
    "c4-warn": {
      "id": "c4-warn",
      "start": 82.093,
      "end": 87.725,
      "seconds": 5.632,
      "text": "If someone isn't normally available that day, Crewflow warns Riley before anything is sent.",
      "chapter": "Request and approve",
      "file": "C:\\Rab-recruit\\packages\\rab-docs\\tools\\narration\\build\\crewflow-introduction\\c4-warn.wav"
    },
    "c4-send": {
      "id": "c4-send",
      "start": 88.325,
      "end": 93.173,
      "seconds": 4.848,
      "text": "The request goes to the manager for approval. Nothing reaches the staff yet.",
      "chapter": "Request and approve",
      "file": "C:\\Rab-recruit\\packages\\rab-docs\\tools\\narration\\build\\crewflow-introduction\\c4-send.wav"
    },
    "c4-approve": {
      "id": "c4-approve",
      "start": 93.873,
      "end": 100.267,
      "seconds": 6.394,
      "text": "In Venue Offers, the manager checks the request, adds or removes people if needed, and approves it.",
      "chapter": "Request and approve",
      "file": "C:\\Rab-recruit\\packages\\rab-docs\\tools\\narration\\build\\crewflow-introduction\\c4-approve.wav"
    },
    "c5-offers": {
      "id": "c5-offers",
      "start": 103.767,
      "end": 109.738,
      "seconds": 5.971,
      "text": "Approval sends each person their own offer, with the venue, the time, and their estimated pay.",
      "chapter": "Offers and confirmation",
      "file": "C:\\Rab-recruit\\packages\\rab-docs\\tools\\narration\\build\\crewflow-introduction\\c5-offers.wav"
    },
    "c5-accept": {
      "id": "c5-accept",
      "start": 110.338,
      "end": 116.925,
      "seconds": 6.587,
      "text": "Priya opens hers and accepts. Because this shift came from an approved request, she's booked straight away.",
      "chapter": "Offers and confirmation",
      "file": "C:\\Rab-recruit\\packages\\rab-docs\\tools\\narration\\build\\crewflow-introduction\\c5-accept.wav"
    },
    "c5-branch": {
      "id": "c5-branch",
      "start": 118.425,
      "end": 125.967,
      "seconds": 7.542,
      "text": "It's different when the manager creates a shift directly. Then, accepting holds the place until the manager confirms it.",
      "chapter": "Offers and confirmation",
      "file": "C:\\Rab-recruit\\packages\\rab-docs\\tools\\narration\\build\\crewflow-introduction\\c5-branch.wav"
    },
    "c5-board": {
      "id": "c5-board",
      "start": 126.567,
      "end": 131.836,
      "seconds": 5.269,
      "text": "Either way, the manager can follow every person on the staffing board in Venue Offers.",
      "chapter": "Offers and confirmation",
      "file": "C:\\Rab-recruit\\packages\\rab-docs\\tools\\narration\\build\\crewflow-introduction\\c5-board.wav"
    },
    "c6-ready": {
      "id": "c6-ready",
      "start": 134.736,
      "end": 141.307,
      "seconds": 6.571,
      "text": "On Friday, Priya's confirmed shift is waiting in her app. Clock-in opens shortly before it starts.",
      "chapter": "Shift day",
      "file": "C:\\Rab-recruit\\packages\\rab-docs\\tools\\narration\\build\\crewflow-introduction\\c6-ready.wav"
    },
    "c6-scan": {
      "id": "c6-scan",
      "start": 141.907,
      "end": 146.835,
      "seconds": 4.928,
      "text": "At the venue, she scans the shift's QR code, and Crewflow's server checks it.",
      "chapter": "Shift day",
      "file": "C:\\Rab-recruit\\packages\\rab-docs\\tools\\narration\\build\\crewflow-introduction\\c6-scan.wav"
    },
    "c6-site": {
      "id": "c6-site",
      "start": 147.635,
      "end": 150.781,
      "seconds": 3.146,
      "text": "Some venues also require her to be on site.",
      "chapter": "Shift day",
      "file": "C:\\Rab-recruit\\packages\\rab-docs\\tools\\narration\\build\\crewflow-introduction\\c6-site.wav"
    },
    "c6-live": {
      "id": "c6-live",
      "start": 151.381,
      "end": 155.96,
      "seconds": 4.579,
      "text": "Her shift is now live, timed by Crewflow's own clock, not her phone's.",
      "chapter": "Shift day",
      "file": "C:\\Rab-recruit\\packages\\rab-docs\\tools\\narration\\build\\crewflow-introduction\\c6-live.wav"
    },
    "c6-out": {
      "id": "c6-out",
      "start": 157.16,
      "end": 161.815,
      "seconds": 4.655,
      "text": "When the shift ends, she scans the same code again to clock out.",
      "chapter": "Shift day",
      "file": "C:\\Rab-recruit\\packages\\rab-docs\\tools\\narration\\build\\crewflow-introduction\\c6-out.wav"
    },
    "c7-report": {
      "id": "c7-report",
      "start": 164.715,
      "end": 167.668,
      "seconds": 2.953,
      "text": "Afterwards, Riley opens the shift report.",
      "chapter": "Review the hours",
      "file": "C:\\Rab-recruit\\packages\\rab-docs\\tools\\narration\\build\\crewflow-introduction\\c7-report.wav"
    },
    "c7-missing": {
      "id": "c7-missing",
      "start": 168.168,
      "end": 177.256,
      "seconds": 9.088,
      "text": "Three people clocked in and out. Isla clocked in, but never clocked out, so Crewflow flags the missing clock-out instead of guessing her hours.",
      "chapter": "Review the hours",
      "file": "C:\\Rab-recruit\\packages\\rab-docs\\tools\\narration\\build\\crewflow-introduction\\c7-missing.wav"
    },
    "c7-correct": {
      "id": "c7-correct",
      "start": 177.856,
      "end": 182.305,
      "seconds": 4.449,
      "text": "Riley enters the right time, gives a reason, and saves the correction.",
      "chapter": "Review the hours",
      "file": "C:\\Rab-recruit\\packages\\rab-docs\\tools\\narration\\build\\crewflow-introduction\\c7-correct.wav"
    },
    "c7-review": {
      "id": "c7-review",
      "start": 183.905,
      "end": 190.484,
      "seconds": 6.579,
      "text": "Saving a correction doesn't approve it. Riley still marks each person's hours as reviewed, one by one.",
      "chapter": "Review the hours",
      "file": "C:\\Rab-recruit\\packages\\rab-docs\\tools\\narration\\build\\crewflow-introduction\\c7-review.wav"
    },
    "c7-rating": {
      "id": "c7-rating",
      "start": 192.284,
      "end": 196.037,
      "seconds": 3.753,
      "text": "Rating each person's work is a separate, optional step.",
      "chapter": "Review the hours",
      "file": "C:\\Rab-recruit\\packages\\rab-docs\\tools\\narration\\build\\crewflow-introduction\\c7-rating.wav"
    },
    "c7-gate": {
      "id": "c7-gate",
      "start": 196.637,
      "end": 201.431,
      "seconds": 4.794,
      "text": "Finalise & send only unlocks once everyone is clocked out and reviewed.",
      "chapter": "Review the hours",
      "file": "C:\\Rab-recruit\\packages\\rab-docs\\tools\\narration\\build\\crewflow-introduction\\c7-gate.wav"
    },
    "c8-sign": {
      "id": "c8-sign",
      "start": 204.731,
      "end": 211.575,
      "seconds": 6.844,
      "text": "Riley confirms the break details, signs off by typing a full name, and sends. That locks the hours.",
      "chapter": "Final timesheet",
      "file": "C:\\Rab-recruit\\packages\\rab-docs\\tools\\narration\\build\\crewflow-introduction\\c8-sign.wav"
    },
    "c8-pdf": {
      "id": "c8-pdf",
      "start": 212.775,
      "end": 219.655,
      "seconds": 6.88,
      "text": "Crewflow then creates the final timesheet as a PDF, queues it for delivery, and shows when it's been sent.",
      "chapter": "Final timesheet",
      "file": "C:\\Rab-recruit\\packages\\rab-docs\\tools\\narration\\build\\crewflow-introduction\\c8-pdf.wav"
    },
    "c8-history": {
      "id": "c8-history",
      "start": 221.455,
      "end": 224.372,
      "seconds": 2.917,
      "text": "In the app, the finished shift moves to History.",
      "chapter": "Final timesheet",
      "file": "C:\\Rab-recruit\\packages\\rab-docs\\tools\\narration\\build\\crewflow-introduction\\c8-history.wav"
    },
    "c8-web": {
      "id": "c8-web",
      "start": 224.872,
      "end": 230.032,
      "seconds": 5.16,
      "text": "In the web console, the manager can open both the original and the signed timesheet.",
      "chapter": "Final timesheet",
      "file": "C:\\Rab-recruit\\packages\\rab-docs\\tools\\narration\\build\\crewflow-introduction\\c8-web.wav"
    },
    "c9-payroll": {
      "id": "c9-payroll",
      "start": 232.932,
      "end": 239.929,
      "seconds": 6.997,
      "text": "Back in the web console, the hours appear in Payroll, with the pay they add up to. Crewflow doesn't move any money.",
      "chapter": "Manage the operation",
      "file": "C:\\Rab-recruit\\packages\\rab-docs\\tools\\narration\\build\\crewflow-introduction\\c9-payroll.wav"
    },
    "c9-reviews": {
      "id": "c9-reviews",
      "start": 240.529,
      "end": 244.86,
      "seconds": 4.331,
      "text": "Ratings from venue managers build up on each staff member's record.",
      "chapter": "Manage the operation",
      "file": "C:\\Rab-recruit\\packages\\rab-docs\\tools\\narration\\build\\crewflow-introduction\\c9-reviews.wav"
    },
    "c9-dash": {
      "id": "c9-dash",
      "start": 245.46,
      "end": 252.18,
      "seconds": 6.72,
      "text": "And the dashboard and calendar show the week ahead, the hours worked, and how ready the next shift is.",
      "chapter": "Manage the operation",
      "file": "C:\\Rab-recruit\\packages\\rab-docs\\tools\\narration\\build\\crewflow-introduction\\c9-dash.wav"
    },
    "c10-system": {
      "id": "c10-system",
      "start": 256.08,
      "end": 265.437,
      "seconds": 9.357,
      "text": "Behind the scenes, the web console and the app share one Crewflow service. On every request, it checks who you are, and which workspace you belong to.",
      "chapter": "Behind the scenes",
      "file": "C:\\Rab-recruit\\packages\\rab-docs\\tools\\narration\\build\\crewflow-introduction\\c10-system.wav"
    },
    "c10-jobs": {
      "id": "c10-jobs",
      "start": 266.037,
      "end": 270.261,
      "seconds": 4.224,
      "text": "Background jobs look after reminders, expiries and documents.",
      "chapter": "Behind the scenes",
      "file": "C:\\Rab-recruit\\packages\\rab-docs\\tools\\narration\\build\\crewflow-introduction\\c10-jobs.wav"
    },
    "c11-recap": {
      "id": "c11-recap",
      "start": 273.161,
      "end": 277.308,
      "seconds": 4.147,
      "text": "Request. Approve. Work. Review. Sign off. That's Crewflow.",
      "chapter": "Get started",
      "file": "C:\\Rab-recruit\\packages\\rab-docs\\tools\\narration\\build\\crewflow-introduction\\c11-recap.wav"
