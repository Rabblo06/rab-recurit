{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "Crewflow Documentation",
  "description": "Guides for managers, venue managers and staff using Crewflow, plus technical documentation for developers.",
  "colors": {
    "primary": "#79543A",
    "light": "#D97A52",
    "dark": "#9C6C4D"
  },
  "logo": {
    "light": "/images/brand/logo-light.png",
    "dark": "/images/brand/logo-dark.png",
    "href": "/"
  },
  "favicon": "/images/brand/favicon.png",
  "fonts": {
    "family": "Inter"
  },
  "appearance": {
    "default": "system"
  },
  "icons": {
    "library": "fontawesome"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "system"
  },
  "interaction": {
    "drilldown": false
  },
  "variables": {
    "appUrl": "https://app.rabworkspaceteams.co.uk",
    "company": "Adolphus Recruitment Solutions"
  },
  "search": {
    "prompt": "Search Crewflow docs…"
  },
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "og:site_name": "Crewflow Documentation"
    }
  },
  "contextual": {
    "options": ["copy", "view"]
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "/support/contact"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open Crewflow",
      "href": "https://app.rabworkspaceteams.co.uk"
    }
  },
