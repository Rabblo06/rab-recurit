# .env.migrate — the environment of the one-off rab-migrate process ONLY (Phase B P7; docs/runbooks/database.md).
#
#   cp packages/rab-docker/.env.migrate.example packages/rab-docker/.env.migrate && chmod 600 packages/rab-docker/.env.migrate
#
# - chmod 600, owned by the deploying operator.
# - git-ignored (.env.migrate, **/.env.migrate) and excluded from the image build context (.dockerignore): it is never in an
#   image layer.
# - referenced ONLY by the rab-migrate service (env_file). It is never passed to rab-api or rab-worker
#   (packages/rab-docker/scripts/compose-credential-isolation.cjs checks that in CI).
# - never leave CREWFLOW_MIGRATION_APPROVED set: pass it for the one approved release run only (see below; a stale
#   value is refused at the next release).
#
# Exit codes of rab-migrate (deploy-prepare.js): 0 ready (nothing pending, or the approved migrations were applied),
# 3 pending migrations but this run is not approved (the release is NOT promoted; the log lists them and prints the
# approval token for exactly that set), 1 refused or failed (a stale, mismatched or malformed approval included).

# The migration-only login (crewflow_migrator: member of rab_secure_owner + crewflow, owns nothing), at the DIRECT host
# (no transaction pooler: the migration lock is a session advisory lock), with TLS verify-full.
PG_DATABASE_URL=postgresql://crewflow_migrator:<password>@<DIRECT host, no pooler>:5432/<db>?sslmode=verify-full
# PG_SSL_CA_CERT_PATH=/run/secrets/pg-ca.pem

DB_TARGET=production
ALLOW_PRODUCTION_DB_COMMANDS=true
CREWFLOW_DEPLOYMENT_ENVIRONMENT=production
CREWFLOW_DEPLOYMENT_ID=<uuid>

# Per-release approval (security review L-2; final review F5): NOT set here by default. The approval names the exact
# pending set: run rab-migrate WITHOUT it first; it exits 3, lists every pending migration and prints
#   approval token for exactly this set: pending-<count>-<sha256>
# Review the list, then run once more with that token, e.g.
#   docker compose ... run --rm -e CREWFLOW_MIGRATION_APPROVED=pending-<count>-<sha256> rab-migrate
# The apply run recomputes the token after taking the migration lock and refuses (exit 1, nothing applied) unless it
# matches the set pending at that moment. A token left here therefore approves nothing later: the next release has a
# different set and refuses it (with its own token). The old value `apply-pending-migrations` is refused.
# CREWFLOW_MIGRATION_APPROVED=pending-<count>-<sha256>

# CREWFLOW_MIGRATION_LOCK_WAIT_SECONDS=600   (1..840)
# CREWFLOW_DEPLOY_CACHE_FLUSH=entitycache
# REDIS_URL=                                  (only with the cache flush)

# MUST NOT contain: DATABASE_URL, DATABASE_URL_UNPOOLED, DATABASE_DIRECT_URL, APP_SECRET or any other runtime secret,
# BOOTSTRAP_ADMIN_*, TEST_*, or libpq PG* variables (PGHOST, PGPASSWORD, PGSSLMODE, ...).
