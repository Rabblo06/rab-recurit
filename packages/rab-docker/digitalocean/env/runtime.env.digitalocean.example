# DIGITALOCEAN runtime.env: the DigitalOcean-SPECIFIC lines only. Start from the generic template (env/runtime.env.example:
# every key, every refusal), copy it to ${CREWFLOW_SECRETS_DIR}/runtime.env (root:root 0600), then set the lines below in
# that copy (replace the generic line where one exists). Never commit or send the filled file.
# Check the real file with BOTH lints (names and reasons only, never a value):
#   node packages/rab-docker/scripts/compose-owner-login.cjs --lint-env-file runtime ${CREWFLOW_SECRETS_DIR}/runtime.env
#   node packages/rab-docker/digitalocean/verify-digitalocean.cjs --lint-env-file runtime ${CREWFLOW_SECRETS_DIR}/runtime.env
#
# --- Connection budget (M9 load test, LOAD-TEST.md; DigitalOcean 2 GiB plan = 47 usable connections) ------------------
# One login (crewflow_owner) for everything. Worst case of this shape, from connection-budget.ts: API pool 9 + /healthz
# probe 1 + Worker pool 12 (committed in the compose file) + Worker lock pool 6 + scan/storage locks 2 + provisioner 2 +
# migrate child 5 + boot probes 3 = 40 of 47 (headroom 7). The API refuses to start if the server allows fewer (fail closed;
# the 1 GiB plan, 22 connections, is refused). The load test ran the API pool at 10 (41 of 47): 9 is the reviewed template
# value and was not the bottleneck (JIT was, decision 49).
PG_POOL_MAX_CONNECTIONS=9
PG_EXPECTED_API_POOL_MAX=9
PG_EXPECTED_API_INSTANCES=1
PG_EXPECTED_WORKER_INSTANCES=1
PG_EXPECTED_WORKER_POOL_MAX=12
#
# --- Redis: the ACL user `crewflow` with its own password (its SHA-256 is in ${CREWFLOW_SECRETS_DIR}/redis-users.acl) -----
REDIS_URL=redis://crewflow:<redis-app-password>@rab-redis:6379
#
# --- Edge: Caddy on the host -> 127.0.0.1:3000 -> Docker's bridge gateway (fixed by the DigitalOcean override) -----------
# Exactly this one address: the only peer whose CF-Connecting-IP rab-api believes.
TRUSTED_PROXY_CIDRS=172.16.30.1/32
#
# --- Public addresses (Cloudflare, proxied, TLS Full (strict)) ---------------------------------------------------------
APP_URL=https://<console-host>
ACCOUNTS_URL=https://<console-host>
CORS_ORIGINS=https://<console-host>
#
# --- Object storage: Cloudflare R2 (decision step 5) or DigitalOcean Spaces in London (lon1) ---------------------------
# R2:     S3_REGION=auto, S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# Spaces: S3_REGION=lon1, S3_ENDPOINT=https://lon1.digitaloceanspaces.com
# A key scoped to this ONE bucket.
S3_BUCKET=<bucket>
S3_REGION=<region-or-auto>
S3_ENDPOINT=https://<s3-compatible-endpoint>
S3_ACCESS_KEY_ID=<bucket-scoped-key-id>
S3_SECRET_ACCESS_KEY=<bucket-scoped-secret>
#
# --- MFA (owner decision 2, steps 1 and 2 at the DigitalOcean move). Exactly true or false. -----------------------------
# Step 1 (now): platform admins. Required before BOOTSTRAP_ADMIN_EMAIL can create the first admin.
AUTH_MFA_ENFORCE_PLATFORM_ADMIN=true
# Step 2 (at the move, before any real data): organisation owners and the Initial Manager. The owner sets these himself
# on the server when he is ready (agents never change them); shown here as the decided target, not as a default.
# AUTH_MFA_ENFORCE_ORGANISATION_OWNER=true
# AUTH_MFA_ENFORCE_INITIAL_MANAGER=true
#
# --- Audit sink: stdout, and an OFF-HOST append-only shipper must collect rab-api and rab-worker stdout (runbook §9) ------
CREWFLOW_AUDIT_SINK=stdout
