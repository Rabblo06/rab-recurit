# DIGITALOCEAN database.env: the shared TLS / database-name / identity settings of db-setup, db-harden, rab-api and
# rab-worker. Template only: copy to ${CREWFLOW_SECRETS_DIR}/database.env (root:root 0600). No credential belongs here.
# Check it:
#   node packages/rab-docker/digitalocean/verify-digitalocean.cjs --lint-env-file database ${CREWFLOW_SECRETS_DIR}/database.env
#   node packages/rab-docker/scripts/compose-owner-login.cjs --lint-env-file database ${CREWFLOW_SECRETS_DIR}/database.env
#
# TLS verify-full against the cluster's own CA (compose.env's CREWFLOW_PG_CA_FILE is mounted at this path, read-only).
PG_SSL_CA_CERT_PATH=/run/crewflow/pg-ca.crt
# Must equal current_database(): the database created for Crewflow on the cluster (never defaultdb).
PG_EXPECTED_DATABASE_NAME=crewflow
#
# Deployment identity (optional, BC-11; recommended on DigitalOcean so a restore-drill copy can never be mistaken for
# production): generate once with `uuidgen`, keep it, never reuse another deployment's id.
# CREWFLOW_DEPLOYMENT_ENVIRONMENT=production
# CREWFLOW_DEPLOYMENT_ID=<deployment-uuid>
