# DIGITALOCEAN compose.env: the Compose INTERPOLATION values for
#   docker-compose.image.yml + digitalocean/docker-compose.digitalocean.yml
# Template only. Copy to /etc/crewflow/compose.env (root:root 0600) and replace every <placeholder> ON THE SERVER. Never
# commit, paste or send the filled file (it holds the database admin URL and the crewflow_owner password).
# Check it (names and reasons only, never a value):
#   node packages/rab-docker/digitalocean/verify-digitalocean.cjs --lint-env-file compose /etc/crewflow/compose.env
#   node packages/rab-docker/scripts/compose-owner-login.cjs --lint-env-file compose /etc/crewflow/compose.env
# The generic template (env/compose.env.example) explains every key; this file is that template with the DigitalOcean
# choices made (owner decision 24 a: Managed PostgreSQL, London; mode b, "you set one shared password").
#
# --- Database: DigitalOcean Managed PostgreSQL (mode b) ---------------------------------------------------------------
# The bundled db is OFF (the DigitalOcean override also pins it to 0 replicas). No PG_DATABASE_PASSWORD (refused: no dummy).
CREWFLOW_BUNDLED_DB=0
# The cluster's ADMIN URL (the `doadmin` user), used ONCE per deploy by the one-shot db-setup and db-harden only; rab-api and
# rab-worker never receive it. From the cluster's Connection Details: choose "VPC network" (the private host) and the
# database `crewflow` (create it under Users & Databases first; never `defaultdb`), Connection string, then change
# sslmode=require to sslmode=verify-full. ALWAYS the DIRECT port 25060, NEVER the pool port 25061 (db-setup refuses a pooler
# by what it does; the DigitalOcean lint refuses 25061 by number).
PG_ADMIN_URL=postgresql://doadmin:<doadmin-password>@<private-cluster-host>.db.ondigitalocean.com:25060/crewflow?sslmode=verify-full
# The crewflow_owner password (the runtime login of rab-api and rab-worker): generate it on the server, keep it.
#   openssl rand -hex 32
PG_DATABASE_APP_PASSWORD=<openssl-rand-hex-32>
# The SAME direct address as PG_ADMIN_URL (compose builds the crewflow_owner URL from these, sslmode=verify-full).
PG_DATABASE_HOST=<private-cluster-host>.db.ondigitalocean.com
PG_DATABASE_PORT=25060
PG_DATABASE_NAME=crewflow
# The cluster's CA certificate ("Download CA certificate" on the cluster page), copied to the server, root:root 0644. It is
# mounted read-only at /run/crewflow/pg-ca.crt; database.env points PG_SSL_CA_CERT_PATH there (verify-full).
CREWFLOW_PG_CA_FILE=/etc/crewflow/do-pg-ca.crt
# Rotation, for ONE deploy only (OWNER-LOGIN-DEPLOYMENT.md "Rotate the crewflow_owner password"), then remove it:
# CREWFLOW_ROTATE_APP_PASSWORD=1
#
# --- Image ------------------------------------------------------------------------------------------------------------
# The approved release's multi-platform INDEX digest (sha256:<64 hex>), never a tag. Rollback = the previous digest here.
CREWFLOW_IMAGE_TAG=sha256:<image-index-digest-64-hex>
# Redis pinned by digest (record the tag it was resolved from). Its ACL file is ${CREWFLOW_SECRETS_DIR}/redis-users.acl
# (template digitalocean/env/redis-users.acl.example: the `default` user is ON with a password (decision 25.3), the app
# user `crewflow` has its own; only the PING-only `healthcheck` user has none).
CREWFLOW_REDIS_IMAGE=redis@sha256:<redis-index-digest-64-hex>
#
# --- Host paths -------------------------------------------------------------------------------------------------------
# root:root 0700: database.env, runtime.env and redis-users.acl (decision step 3: secrets live here, never in chat).
CREWFLOW_SECRETS_DIR=/etc/crewflow/secrets
#
# --- Where the edge proxy connects ------------------------------------------------------------------------------------
# Loopback only: Caddy on the host connects here. Never 0.0.0.0 (the droplet firewall is the second fence, not the first).
CREWFLOW_API_BIND=127.0.0.1
CREWFLOW_API_HOST_PORT=3000
#
# --- First platform admin (once; remove after the admin has activated and enrolled MFA) -------------------------------
# rab-api only. Needs AUTH_MFA_ENFORCE_PLATFORM_ADMIN=true in runtime.env (decision 2 step 1), otherwise nothing is created.
# BOOTSTRAP_ADMIN_EMAIL=<your-email>
#
# --- Resource limits: Basic droplet 4 vCPU / 8 GB (no database container on the droplet) ------------------------------
CREWFLOW_API_MEM_LIMIT=1024m
CREWFLOW_API_CPUS=2
CREWFLOW_WORKER_MEM_LIMIT=1536m
CREWFLOW_WORKER_CPUS=2
CREWFLOW_REDIS_MAXMEMORY=384mb
CREWFLOW_REDIS_CPUS=1
#
# AI stays OFF in production (AI_ENABLED unset = false). Do not add it.
# MUST NOT BE SET here: PG_DATABASE_PASSWORD, PG_DATABASE_URL together with PG_DATABASE_APP_PASSWORD, any other password,
# URL or token, COMPOSE_* (name the files with -f), and every application variable (they belong in runtime.env).
