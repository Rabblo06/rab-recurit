# DIGITALOCEAN edge: Caddy on the droplet HOST (the Debian/Ubuntu `caddy` package, its systemd unit, user `caddy`), in front
# of rab-api on 127.0.0.1:3000. Needs Caddy 2.8 or later (the `trust_pool file` syntax). Template only: copy to /etc/caddy/Caddyfile and replace <api-host>. Runbook:
# packages/rab-docker/docs/deploy/DIGITALOCEAN.md §6. Check it: `caddy validate --config /etc/caddy/Caddyfile`.
#
# Three fences, any ONE of which keeps a non-Cloudflare client out (decision 25.4, "80/443 open to Cloudflare only"):
#   1. the DigitalOcean Cloud Firewall: 443 (and 80) inbound from Cloudflare's published ranges only;
#   2. mutual TLS: Cloudflare Authenticated Origin Pulls. Cloudflare presents its origin-pull client certificate on every
#      request to the origin; Caddy refuses any TLS handshake without it (the CA file comes from Cloudflare's docs, below);
#   3. remote_ip: a request whose TCP peer is not a Cloudflare range is refused before it reaches rab-api.
# Only then is Cloudflare's CF-Connecting-IP header trustworthy, and rab-api believes it only from 172.30.0.1 (the Docker
# bridge gateway Caddy's loopback connection arrives from; runtime.env TRUSTED_PROXY_CIDRS=172.30.0.1/32).
#
# TLS: a Cloudflare ORIGIN CA certificate for <api-host> (Cloudflare dashboard -> SSL/TLS -> Origin Server -> Create
# Certificate; 15 years; private key shown once). Cloudflare's SSL mode for the zone: Full (strict). No ACME, no port 80
# challenge: Caddy never asks a public CA for a certificate.
#   /etc/caddy/tls/origin.crt                 the Origin CA certificate          root:caddy 0640
#   /etc/caddy/tls/origin.key                 its private key                    root:caddy 0640
#   /etc/caddy/tls/cloudflare-origin-pull-ca.pem   Cloudflare's origin-pull CA   root:caddy 0644
#     (developers.cloudflare.com/ssl/origin-configuration/authenticated-origin-pull/set-up/zone-level/: download the
#      certificate linked there; then turn Authenticated Origin Pulls ON for the zone)
{
	# No automatic HTTPS: the certificate is the Origin CA one above; nothing listens for an ACME challenge.
	auto_https off
	# The admin API stays on the host's loopback (Caddy's default), never on the network.
	admin localhost:2019
	servers {
		# HTTP/1.1 and HTTP/2 to Cloudflare; no HTTP/3 (UDP 443 stays closed in the firewall).
		protocols h1 h2
	}
}

(cloudflare_only) {
	# Cloudflare's published ranges, snapshot 2026-11-21 from https://www.cloudflare.com/ips-v4 and /ips-v6. Refresh with
	# the same lists as the droplet firewall (runbook §5): a missing new range only refuses Cloudflare traffic (fails
	# closed), it never lets anyone else in.
	@not_cloudflare not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	abort @not_cloudflare
}

https://<api-host> {
	tls /etc/caddy/tls/origin.crt /etc/caddy/tls/origin.key {
		protocols tls1.2 tls1.3
		client_auth {
			mode require_and_verify
			trust_pool file /etc/caddy/tls/cloudflare-origin-pull-ca.pem
		}
	}
	import cloudflare_only
	# No body-size cap here: the API enforces its own upload limits (storage/upload-limits.ts); Cloudflare Free caps
	# request bodies at 100 MB.
	reverse_proxy 127.0.0.1:3000 {
		# CF-Connecting-IP passes through unchanged (fences 1-3 make it Cloudflare's). Caddy appends the Cloudflare edge
		# address to X-Forwarded-For; rab-api prefers CF-Connecting-IP from its one trusted peer.
		header_up Host {host}
	}
	log {
		output file /var/log/caddy/api-access.log {
			roll_size 50MiB
			roll_keep 10
		}
		format json
	}
}

# Port 80: Cloudflare's "Always Use HTTPS" redirects browsers before they reach the origin, so nothing legitimate arrives
# here. Answer only Cloudflare, and only with a redirect.
http://<api-host> {
	import cloudflare_only
	redir https://{host}{uri} permanent
}
