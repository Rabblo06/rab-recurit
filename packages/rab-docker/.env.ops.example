# .env.ops — the environment of the ONE-OFF rab-ops container ONLY (Phase B owner CLI operations; docs/runbooks/database.md,
# section "Owner operations container").
#
#   cp packages/rab-docker/.env.ops.example packages/rab-docker/.env.ops && chmod 600 packages/rab-docker/.env.ops
#   docker compose -f packages/rab-docker/docker-compose.production.yml --profile ops run --rm rab-ops <command> [args]
#
# - Created for ONE approved run, chmod 600, deleted (shred) right after it. Prefer the CI job's protected-environment
#   secrets over a file on a host (runbook: the GitHub Actions example injects these as job environment instead).
# - git-ignored (.env.ops, **/.env.ops) and excluded from the image build context (.dockerignore): never in an image layer.
# - referenced ONLY by the rab-ops service (profile "ops"; it never starts with `up`). Never passed to rab-api, rab-worker or
#   rab-migrate: their processes refuse every CREWFLOW_OPS_* / PG_OPS_* name (packages/rab-docker/scripts/
#   compose-credential-isolation.cjs checks the compose files in CI).
# - The ops container runs only containment:suspend-test-accounts, hws:backfill and user-session:backfill; anything else
#   is refused, and those three are refused anywhere else.

CREWFLOW_OPS_RUN=one-off

# The ORDINARY restricted runtime login (crewflow_app) at the DIRECT host, verify-full. This is the CLI's primary connection
# (boot gates, tenant-context writes, audit rows). It is the normal runtime credential, not a new privileged one.
PG_OPS_APP_DATABASE_URL=postgresql://crewflow_app:<password>@<DIRECT host>:5432/<db>?sslmode=verify-full

# ONLY for a mode that needs the verified elevated session (containment, user-session:backfill --dry-run/--apply): the
# migration identity (crewflow_migrator) — the same short-lived credential rab-migrate uses. Leave it OUT for
# user-session:backfill --verify and every hws:backfill mode (they refuse it). Set the login back to NOLOGIN after the run.
# PG_DATABASE_URL=postgresql://crewflow_migrator:<password>@<DIRECT host>:5432/<db>?sslmode=verify-full
# PG_SSL_CA_CERT_PATH=/run/secrets/pg-ca.pem

DB_TARGET=production
ALLOW_PRODUCTION_DB_COMMANDS=true
CREWFLOW_DEPLOYMENT_ENVIRONMENT=production
CREWFLOW_DEPLOYMENT_ID=<uuid>
PG_EXPECTED_DATABASE_NAME=<db>

# The OPERATIONAL AUDIT LABEL (required; recorded verbatim on every audit row the run writes, marked "operational label, not
# database-verified identity"). Take them from the deployment platform's job identity, never type a person's claim.
# CREWFLOW_OPS_ACTOR_SOURCE: github-actions | gitlab-ci | manual-console
CREWFLOW_OPS_ACTOR_SOURCE=manual-console
CREWFLOW_OPS_ACTOR_ID=<CI OIDC subject / run id / deploy user>
CREWFLOW_OPS_CHANGE_REF=<approved ticket or PR, e.g. OPS-123>

# What the CLI also needs to boot (same values as rab-api, entered for this run only): APP_SECRET (and the keyrings if used),
# REDIS_URL, EMAIL_DRIVER, STORAGE_* / S3_*, CORS_ORIGINS, APP_URL, ACCOUNTS_URL, TRUSTED_PROXY_CIDRS.
#
# MUST NOT contain: DATABASE_URL, DATABASE_URL_UNPOOLED, DATABASE_DIRECT_URL, DB_POOL_MAX, PG_DATABASE_REPLICA_URL,
# CREWFLOW_MIGRATION_APPROVED, CREWFLOW_PROVISIONER_DATABASE_URL, BOOTSTRAP_ADMIN_*, TEST_*, libpq PG* variables.
