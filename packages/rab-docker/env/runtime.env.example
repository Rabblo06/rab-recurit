# OWNER-LOGIN DEPLOYMENT — the RUNTIME env file for rab-api and rab-worker ONLY (never the release step).
# Template only: copy to ${CREWFLOW_SECRETS_DIR}/runtime.env (root:root 0600) and fill every <placeholder>. The database URL
# is NOT here: it is in database.env only, so it is identical on every service.
# Lint it: node packages/rab-docker/scripts/compose-owner-login.cjs --lint-env-file runtime ${CREWFLOW_SECRETS_DIR}/runtime.env
#
# PRODUCTION CONFIG REFUSALS (env.validation.ts, rab-api and rab-worker): the process refuses to boot unless EMAIL_DRIVER
# is SMTP or RESEND, STORAGE_DRIVER is S3 (committed), APP_URL and ACCOUNTS_URL are https:// and not localhost,
# CORS_ORIGINS lists only https:// origins, and TRUSTED_PROXY_CIDRS is non-empty and narrow.
#
# Connection budget: ONE login, so every pool shares crewflow_owner's connection limit. Same values on both services.
# rab-worker's own PG_POOL_MAX_CONNECTIONS=12 is committed in the compose file (the compose value wins there).
PG_POOL_MAX_CONNECTIONS=9
PG_EXPECTED_API_POOL_MAX=9
PG_EXPECTED_API_INSTANCES=1
PG_EXPECTED_WORKER_INSTANCES=1
PG_EXPECTED_WORKER_POOL_MAX=12
#
# Redis: the ACL application user `crewflow` (its password's SHA-256 is in ${CREWFLOW_SECRETS_DIR}/redis-users.acl).
REDIS_URL=redis://crewflow:<redis-app-password>@rab-redis:6379
#
# Secrets (generate fresh, at least 32 random bytes each: openssl rand -hex 48). APP_SECRET derives the encryption and
# JWT keys: changing it later breaks every session and every stored encrypted secret. In a TRANSITION from the separated
# deployment, keep the CURRENT values unchanged.
APP_SECRET=<app-secret>
# Only if this deployment uses keyrings:
# APP_ENCRYPTION_KEYRING=<keyring>
# APP_ENCRYPTION_ACTIVE_KID=<kid>
# APP_JWT_SIGNING_KEYRING=<keyring>
# APP_JWT_ACTIVE_KID=<kid>
#
# URLs (https only).
APP_URL=https://<app-host>
ACCOUNTS_URL=https://<app-host>
CORS_ORIGINS=https://<app-host>
# The exact address/range of the edge proxy that connects to rab-api: 127.0.0.1/32 when the proxy runs on the host and
# connects to the loopback-published port; the proxy container's address when it shares a Docker network.
TRUSTED_PROXY_CIDRS=<edge-proxy-cidr>
#
# Email.
EMAIL_DRIVER=SMTP
EMAIL_SMTP_HOST=<smtp-host>
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=<smtp-user>
EMAIL_SMTP_PASSWORD=<smtp-password>
EMAIL_FROM_ADDRESS=<sender-address>
# Or: EMAIL_DRIVER=RESEND with RESEND_API_KEY=<key>
#
# Object storage (S3-compatible; R2 uses S3_REGION=auto). A key scoped to this bucket only.
S3_BUCKET=<bucket>
S3_REGION=<region-or-auto>
S3_ENDPOINT=https://<s3-compatible-endpoint>
S3_ACCESS_KEY_ID=<bucket-scoped-key-id>
S3_SECRET_ACCESS_KEY=<bucket-scoped-secret>
#
# Optional startup / watchdog tuning (code defaults shown; set only to change them). Each is read by the named service.
# rab-api: seconds to wait before exiting after a startup failure (bounds Docker's restart loop against the database).
# CREWFLOW_STARTUP_FAILURE_DELAY_SECONDS=15        # 0..300
# rab-worker: an event loop silent for this long is a stall; the watchdog kills the process (needs `init: true`).
# CREWFLOW_WORKER_WATCHDOG_STALE_SECONDS=120       # 30..900
# rab-worker: how long to wait for the schema to be current before refusing to start (the Worker never migrates).
# CREWFLOW_WORKER_SCHEMA_WAIT_SECONDS=900          # 0..3600
#
# Optional.
# SENTRY_DSN=<dsn>
# APP_VERSION=<release commit>
# AUTH_GOOGLE_* / AUTH_MICROSOFT_*   only if that provider is enabled.
# WORKSPACE_BASE_DOMAIN              OWNER DECISION (production runbook D6); leave unset unless approved.
#
# MUST NOT BE SET in this file (the lint refuses each):
#   - PG_DATABASE_URL or ANY other database URL (it lives in database.env only): DATABASE_URL, DATABASE_URL_UNPOOLED,
#     DATABASE_DIRECT_URL, PG_WORKER_DATABASE_URL, CREWFLOW_PROVISIONER_DATABASE_URL, CREWFLOW_MIGRATION_DATABASE_URL,
#     CREWFLOW_PRESTART_MIGRATION_DATABASE_URL, PG_DATABASE_REPLICA_URL, PG_OPS_APP_DATABASE_URL, POSTURE_DATABASE_URL,
#     DRIFT_DATABASE_URL, TEST_*;
#   - CREWFLOW_MIGRATION_APPROVED, CREWFLOW_MIGRATION_PHASE, CREWFLOW_MIGRATOR_PASSWORD, CREWFLOW_*_BOOTSTRAP_PASSWORD,
#     CREWFLOW_DEPLOYMENT_IDENTITY_BOOTSTRAP, ALLOW_PRODUCTION_DB_COMMANDS, DB_TARGET, DB_POOL_MAX, CREWFLOW_DB_MODE,
#     BOOTSTRAP_ADMIN_* (bootstrap-admin is a one-off operator command, never a runtime variable);
#   - the libpq variables (PGHOST, PGPASSWORD, ...), CREWFLOW_OPS_*, ALLOW_REMOTE_TEST_DATABASE, AUTH_*_ISSUER_URL;
#   - NODE_OPTIONS (--require/--inspect would load code into both processes);
#   - WORKER_INVITE_AUTO_DELETE_ENABLED (refused in production until the owner approves a retention policy; under the owner
#     login the legacy cleanup path would delete invited accounts across all tenants: M0 D-1);
#   - WORKER_CLAIM_MODE / WORKER_DISPATCH_MODE (Phase D global claims needed the separate crewflow_worker login; migration
#     1786721330000 stays excluded);
#   - WORKSPACE_SUBDOMAIN_ORIGIN_TRUST_ENABLED (separate owner approval);
#   - CREWFLOW_PROVISIONER_ENABLED (the separated launcher's switch; provisioning runs in-process now);
#   - CREWFLOW_MIGRATION_APPROVAL_MODE, CREWFLOW_DEPLOYMENT_ENVIRONMENT, CREWFLOW_DEPLOYMENT_ID (optional, BC-11; set them in
#     database.env only, so rab-api, rab-worker and rab-migrate see the same value);
#   - anything committed in the compose files (NODE_ENV, RAB_RUNTIME_ENV, CREWFLOW_MIGRATE_ON_START,
#     CREWFLOW_UPGRADE_FAILURE_POLICY, CREWFLOW_RUNTIME_ISOLATION, AI_ENABLED,
#     HWS_RUNTIME_ENABLED, STORAGE_DRIVER, STORAGE_KEY_PREFIX, S3_FORCE_PATH_STYLE, S3_SERVER_SIDE_ENCRYPTION,
#     WORKER_SCHEDULER, HOME, TMPDIR, XDG_CONFIG_HOME, XDG_CACHE_HOME, CREWFLOW_INSTANCE_HEALTH_FILE).
