# syntax=docker/dockerfile:1
#
# Crewflow Worker bundle image: the ordinary Worker (jobs) and the Workspace Provisioner as two supervised OS processes
# in ONE Worker deployment service. Built FROM the shared application image (packages/rab-docker/rab/Dockerfile, final
# stage `rab`) — this is a SEPARATE Dockerfile on purpose: appending a stage to the shared Dockerfile would change the
# default final stage that platforms without `--target` support (OpenShip, Render) build for the API.
#
# Usage (local):
#   docker build -t crewflow-app:<tag> -f packages/rab-docker/rab/Dockerfile .
#   docker build -t crewflow-worker-bundle:<tag> --build-arg CREWFLOW_BASE_IMAGE=crewflow-app:<tag> \
#     -f packages/rab-docker/rab/Dockerfile.worker-bundle .
# Compose passes the shared image as a named build context (`additional_contexts: crewflow-app: service:<api service>`).
#
# What this layer changes (and nothing else):
#   - H2: Chromium lives ONLY here, in the Worker runtime layer. The shared image (the API image) carries no browser,
#     fonts or CHROMIUM_* settings; this file installs Alpine's chromium + nss/freetype/harfbuzz + fonts from the stable
#     v3.24 repositories, runs the Chromium/libexpat/Node security floors (packages/rab-docker/rab/security-floors.env,
#     fail closed) and sets CHROMIUM_EXECUTABLE_PATH / CHROMIUM_NO_SANDBOX / PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD for the
#     renderer (packages/rab-worker/src/queues/rab-reports/render-pdf.util.ts, the only browser launcher). Every
#     application layer below is the API image's own (shared, not duplicated);
#   - H3: the Worker-only production dependencies (today: playwright and playwright-core, the browser driver) are added
#     to the API image's node_modules, which no longer contains them. The `worker-modules` stage resolves @rab/worker's
#     production closure from the same lockfile and copies ONLY the packages it adds; it refuses to build unless every
#     package of the API tree is in the Worker tree at the same path and version (so the API layers are reused unchanged)
#     and every added package needs no install script or native build (that stage runs none). The final stage proves the
#     Worker's closure: every import in the Worker, server, shared and emails dist resolves, and no build or test tool is
#     present (runtime-deps.cjs);
#   - nothing about /app ownership any more: since H1 the shared image already ships application code and dependencies
#     root-owned and not group/other-writable, so neither child identity can rewrite code the other imports. This build
#     re-verifies that and REFUSES a base image that does not meet it (e.g. one built from an older Dockerfile, which
#     shipped them owned by node:node = the jobs UID); the launcher re-checks the entry points at every start;
#   - the API entry scripts (start.sh, api-prestart.sh) and start-worker.sh are removed: they start the API (which never
#     migrates since Phase B; migrations run only in rab-migrate) and never belong in this service;
#   - a dedicated provisioner identity (10001:10001), separate 0700 temp/home directories, and per-child health
#     directories (writable only by their own child) are created;
#   - tini becomes PID 1 (reaps orphaned Chromium processes, forwards signals) and the dependency-free launcher runs as
#     root ONLY to start each child under its own non-root UID/GID.
# No dotenv file is copied (the repo's .dockerignore excludes them; the build re-checks). No secret is baked in.
#
# Cost: the Chromium layer plus a few small layers on top of the shared image. Before H1 a recursive
# `chown -R root:root /app; chmod -R go-w /app` here rewrote node_modules as one extra layer of about 1.08 GB unpacked /
# 144 MB compressed.
ARG CREWFLOW_BASE_IMAGE
FROM ${CREWFLOW_BASE_IMAGE} AS app

# H3: the Worker's production dependency closure, resolved from the committed manifests and lockfile with the same pinned
# Node image as the shared Dockerfile. Lifecycle scripts are disabled: nothing is built here, and the packages the Worker
# adds must not need building (runtime-deps.cjs worker-delta refuses one that does). Only the delta reaches the image.
FROM node:24-alpine@sha256:8a32c8cf649a49915a66e81e7a609223c708d0adabf288ee3f4077d765542f85 AS worker-modules
WORKDIR /app
COPY package.json yarn.lock .yarnrc.yml ./
COPY .yarn ./.yarn
COPY packages/rab-server/package.json packages/rab-server/package.json
COPY packages/rab-worker/package.json packages/rab-worker/package.json
COPY packages/rab-shared/package.json packages/rab-shared/package.json
COPY packages/rab-ui/package.json packages/rab-ui/package.json
COPY packages/rab-front/package.json packages/rab-front/package.json
COPY packages/rab-emails/package.json packages/rab-emails/package.json
COPY packages/rab-e2e-testing/package.json packages/rab-e2e-testing/package.json
COPY packages/rab-utils/package.json packages/rab-utils/package.json
RUN --mount=type=bind,from=app,source=/app/node_modules,target=/api/node_modules \
    --mount=type=bind,source=packages/rab-docker/rab/runtime-deps.cjs,target=/tmp/runtime-deps.cjs \
    set -eu; \
    lock="$(sha256sum yarn.lock)"; \
    corepack enable; \
    YARN_ENABLE_SCRIPTS=false yarn workspaces focus @rab/worker --production; \
    test "$(sha256sum yarn.lock)" = "$lock"; \
    nested="$(find packages -mindepth 2 -maxdepth 2 -name node_modules -print)"; \
    if [ -n "$nested" ]; then echo "FATAL: the production install put packages under a workspace:"; echo "$nested"; exit 1; fi; \
    node /tmp/runtime-deps.cjs worker-delta /api/node_modules /app/node_modules /worker-delta; \
    test -d /worker-delta/node_modules; \
    find /worker-delta ! -type l -perm /022 -exec chmod go-w {} +

FROM app
USER root
ARG MIN_NODE_VERSION
ARG MIN_CHROMIUM_VERSION
ARG MIN_LIBEXPAT_VERSION

# System Chromium for the Worker's PDF jobs (pre-shift roster, final timesheet, pay statements). Playwright's own
# downloaded Chromium is glibc-only and does not run on Alpine/musl, so the renderer is pointed at Alpine's Chromium via
# the env below. Fonts: without them Chromium renders blank text. Resolved fresh from the base image's stable v3.24
# repositories (upgrade first, so shared libraries Chromium links against are current too); no edge repository. tini
# (PID 1, below) comes from the same apk transaction. The renderer always runs Chromium with --no-sandbox
# (CHROMIUM_NO_SANDBOX=true below), so the setuid-root sandbox helper is never used: its setuid bit is dropped (security
# review H1-L2; the gate further down refuses any setuid/setgid file).
RUN apk upgrade --no-cache \
  && apk add --no-cache chromium nss freetype harfbuzz ttf-liberation font-noto tini \
  && chmod u-s /usr/lib/chromium/chrome-sandbox \
  && test -z "$(apk info -e python3 make g++ gcc)"
# Security floors after the last browser apk transaction: fail the build if Chromium, libexpat or Node is below its floor
# or any repository other than the stable v3.24 main/community is configured.
RUN --mount=type=bind,source=packages/rab-docker/rab/security-floors.sh,target=/tmp/security-floors.sh \
    --mount=type=bind,source=packages/rab-docker/rab/security-floors.env,target=/tmp/security-floors.env \
    sh /tmp/security-floors.sh /tmp/security-floors.env node alpine apk-required:chromium apk-required:libexpat
ENV CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium CHROMIUM_NO_SANDBOX=true PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

RUN set -eux; \
    test -x /sbin/tini; \
    test "$(id -u node)" = 1000; test "$(id -g node)" = 1000; \
    addgroup -g 10001 crewflow-provisioner; \
    adduser -D -H -h /nonexistent -s /sbin/nologin -u 10001 -G crewflow-provisioner crewflow-provisioner; \
    test -z "$(id -G node | tr ' ' '\n' | grep -vx 1000 || true)"; \
    test -z "$(id -G crewflow-provisioner | tr ' ' '\n' | grep -vx 10001 || true)"; \
    rm -f /app/start.sh /app/start-worker.sh /app/api-prestart.sh; \
    test "$(stat -c %u:%g /app)" = 0:0; \
    bad="$(find /app -path /app/storage -prune -o ! -type l \( ! -user 0 -o ! -group 0 -o -perm /022 \) -print | head -n 20)"; \
    if [ -n "$bad" ]; then echo "FATAL: base image application code is not root-owned, or is group/other-writable (rebuild the shared image from the current Dockerfile):"; echo "$bad"; exit 1; fi; \
    mkdir -p /app/storage; chown 1000:1000 /app/storage; chmod 0750 /app/storage; \
    mkdir -p /tmp/crewflow-jobs /tmp/crewflow-provisioner /run/crewflow-health/jobs /run/crewflow-health/provisioner; \
    chown 1000:1000 /tmp/crewflow-jobs /run/crewflow-health/jobs; \
    chown 10001:10001 /tmp/crewflow-provisioner /run/crewflow-health/provisioner; \
    chmod 0700 /tmp/crewflow-jobs /tmp/crewflow-provisioner; \
    chmod 0755 /run/crewflow-health /run/crewflow-health/jobs /run/crewflow-health/provisioner; \
    test -f /app/packages/rab-worker/dist/main.js; \
    test -f /app/packages/rab-worker/dist/workspace-provisioner.main.js; \
    test -f /app/packages/rab-server/dist/database/typeorm/workspace-schema/provision-workspace-schema.js; \
    test -d /app/packages/rab-shared/dist-cjs; test -d /app/packages/rab-emails/dist; \
    test -x "$CHROMIUM_EXECUTABLE_PATH"; \
    for f in /app/.env /app/packages/rab-worker/.env /app/packages/rab-worker/.env.provisioner /app/packages/rab-server/.env; do test ! -e "$f"; done; \
    test -z "$(find /app -path /app/node_modules -prune -o -name '.env*' -print)"

# H3: the Worker-only packages, root-owned (COPY's default) and not group/other-writable (cleared in worker-modules); the
# ownership gate above already covers everything under /app, and is repeated for these by the setuid/ownership check below.
COPY --from=worker-modules /worker-delta/node_modules/ /app/node_modules/
# H3 runtime-dependency gate for the Worker: every bare import in the code the two children run resolves, the browser
# driver is present, and no build or test tool is anywhere in node_modules.
RUN --mount=type=bind,source=packages/rab-docker/rab/runtime-deps.cjs,target=/tmp/runtime-deps.cjs \
    set -eu; \
    node /tmp/runtime-deps.cjs check /app/node_modules \
      --scan /app/packages/rab-worker/dist /app/packages/rab-server/dist /app/packages/rab-shared/dist-cjs /app/packages/rab-emails/dist \
      --forbid typescript nx '@nx/*' jest '@jest/*' ts-jest ts-node ts-node-dev tsx vite esbuild '@esbuild/*' prettier eslint '@swc/*' \
        webpack react-email @playwright/test supertest aws-sdk-client-mock @nestjs/testing concurrently wait-on; \
    test -f /app/node_modules/playwright-core/package.json; \
    bad="$(find /app/node_modules ! -type l \( ! -user 0 -o ! -group 0 -o -perm /022 \) -print | head -n 20)"; \
    if [ -n "$bad" ]; then echo "FATAL: Worker dependencies not root-owned or group/other-writable:"; echo "$bad"; exit 1; fi

COPY --chown=root:root --chmod=0444 packages/rab-docker/rab/worker-bundle/start-worker-bundle.cjs packages/rab-docker/rab/worker-bundle/worker-bundle-health.cjs /opt/crewflow-bundle/
# COPY --chmod also applied 0444 to the new directory; root in this container has no CAP_DAC_* capabilities, so the
# directory itself must be traversable (0755) for the launcher and the health check to be readable at all.
RUN chmod 0755 /opt/crewflow-bundle && test "$(stat -c %a /opt/crewflow-bundle/start-worker-bundle.cjs)" = 444 \
  && suid="$(find / -xdev -type f -perm /6000 -print | head -n 20)" \
  && if [ -n "$suid" ]; then echo "FATAL: setuid/setgid files in the Worker image:"; echo "$suid"; exit 1; fi

# Security review H1-M1 gate, as each child identity with the HOME the launcher gives it (/nonexistent): no Node module
# search path may be writable or creatable, and planting $HOME/.node_modules/pg-native must fail. The launcher's TMPDIR /
# XDG_* directories are not module search paths. Back to root afterwards: the launcher must start as root (see above).
USER 1000:1000
RUN --mount=type=bind,source=packages/rab-docker/rab/module-paths-gate.cjs,target=/tmp/module-paths-gate.cjs \
    HOME=/nonexistent node /tmp/module-paths-gate.cjs
USER 10001:10001
RUN --mount=type=bind,source=packages/rab-docker/rab/module-paths-gate.cjs,target=/tmp/module-paths-gate.cjs \
    HOME=/nonexistent node /tmp/module-paths-gate.cjs
USER root

WORKDIR /app
# No EXPOSE: neither child listens. No debugger/inspector port (NODE_OPTIONS is never forwarded to a child).
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 CMD ["node", "/opt/crewflow-bundle/worker-bundle-health.cjs"]
ENTRYPOINT ["/sbin/tini", "-s", "--"]
CMD ["node", "/opt/crewflow-bundle/start-worker-bundle.cjs"]
