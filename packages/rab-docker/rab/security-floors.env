# Crewflow image security floors: the ONE place to raise a minimum version after a security release.
#
# Read at build time (never shipped in an image) by packages/rab-docker/rab/security-floors.sh, which every runtime stage
# runs through `RUN --mount=type=bind`. A resolved version below any floor FAILS THE BUILD; there is no warn-only mode.
# A build argument of the same name can only RAISE a floor (the higher of the two wins), never lower it.
# Plain KEY=VALUE lines only; this file is parsed, never sourced or executed.
#
# Node.js: 24.22.1 = the 2026-10-20 Node 24 security release (8 CVE IDs). The node:24-alpine base must carry >= this.
MIN_NODE_VERSION=24.22.1
# Chromium (Alpine v3.24/community): 156.0.8078.79 = Chrome stable of 2026-10-29; Chrome 156.0.8078.73 + .79 fixed
# 5 Critical / 65 High. Neither Trivy nor Docker Scout can flag an old Alpine Chromium (Alpine's secdb stops at 144).
MIN_CHROMIUM_VERSION=156.0.8078.79-r0
# libexpat (Alpine v3.24/main): 2.10.0-r0 fixes CVE-2026-113351, -115506, -117610, -118370 (High).
MIN_LIBEXPAT_VERSION=2.10.0-r0
# Every apk resolution must come from this stable Alpine branch only: no edge, no mixing of branches.
ALPINE_BRANCH=v3.24
