# rab-migrate environment (.env.migrate next to the compose file) for a STAGING release window. Template only.
# root:root 0600, never on a runtime service. Recommended: create it before the window and delete it after; between
# releases restart the services with `up -d --no-deps` (a plain `up` runs rab-migrate and needs this file). Keeping it
# permanently, as docker-compose.production.yml assumes, is the owner's alternative (runbook section 5, step 7).
#
# The migration identity at the DIRECT host. First install: phase A as rab_owner, phase B as the bootstrap identity
# (runbook section 5). Every later release: crewflow_migrator.
PG_DATABASE_URL=postgresql://<migration-login>:<password>@<staging-db-direct-host>:5432/<staging-db-name>?sslmode=verify-full
PG_SSL_CA_CERT_PATH=/run/crewflow/pg-ca.crt
PG_EXPECTED_DATABASE_NAME=<staging-db-name>
# Production command authority, required because staging is production-classified (runbook section 2).
ALLOW_PRODUCTION_DB_COMMANDS=true
CREWFLOW_DEPLOYMENT_ENVIRONMENT=production
CREWFLOW_DEPLOYMENT_ID=<staging-deployment-uuid>
# First install only, until db:bind-identity has bound the database; remove it afterwards (a bound database refuses it):
# CREWFLOW_DEPLOYMENT_IDENTITY_BOOTSTRAP=unbound-production-database
# First install, phase B only (the passwords the role-split migrations set; rotate them after the bootstrap):
# CREWFLOW_BOOTSTRAP_PASSWORD=<staging-crewflow-password>
# CREWFLOW_APP_BOOTSTRAP_PASSWORD=<staging-crewflow_app-password>
#
# NEVER here: CREWFLOW_MIGRATION_APPROVED (pass the per-run token on the command line), DATABASE_URL, DATABASE_URL_UNPOOLED,
# DATABASE_DIRECT_URL, APP_SECRET or any runtime secret, BOOTSTRAP_ADMIN_*, TEST_*, libpq PG* variables.
