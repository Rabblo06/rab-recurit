# rab-api environment for STAGING. Template only: copy to ${CREWFLOW_SECRETS_DIR}/api.env (root:root 0600) and fill every
# <placeholder> from the staging secret store. Every value is STAGING-ONLY: never reuse a production or temporary-deployment
# value (database passwords, APP_SECRET, keyrings, S3 keys, SMTP/Resend keys, OAuth clients, Sentry DSN).
# Contract: docker-compose.production.yml, the "ENVIRONMENT" / "MUST NOT BE ENTERED" comment block and its REQUIRED / OPTIONAL lists.
#
# Database: the restricted runtime login at the DIRECT host (never a transaction pooler), TLS verify-full.
PG_DATABASE_URL=postgresql://crewflow_app:<staging-crewflow_app-password>@<staging-db-direct-host>:5432/<staging-db-name>?sslmode=verify-full
PG_SSL_CA_CERT_PATH=/run/crewflow/pg-ca.crt
PG_EXPECTED_DATABASE_NAME=<staging-db-name>
# Deployment identity. The code has no staging runtime path: a NODE_ENV=production process must declare "production", so
# staging is a production-CLASSIFIED deployment bound to its OWN deployment id (runbook section 2, NEEDS OWNER APPROVAL).
# The id is a fresh UUID generated for staging; production's id is never used here, and production refuses this database.
CREWFLOW_DEPLOYMENT_ENVIRONMENT=production
CREWFLOW_DEPLOYMENT_ID=<staging-deployment-uuid>
# Connection budget (the same instance/pool values on rab-api and rab-worker).
PG_POOL_MAX_CONNECTIONS=9
PG_EXPECTED_API_POOL_MAX=9
PG_EXPECTED_API_INSTANCES=1
PG_EXPECTED_WORKER_INSTANCES=1
PG_EXPECTED_WORKER_POOL_MAX=12
# Redis: the ACL application user (the password's SHA-256 is in redis-users.acl).
REDIS_URL=redis://crewflow:<staging-redis-app-password>@rab-redis:6379
# Secrets (generate fresh: at least 32 random bytes each).
APP_SECRET=<staging-app-secret>
# URLs (https only; staging host names).
APP_URL=https://<staging-app-host>
ACCOUNTS_URL=https://<staging-app-host>
CORS_ORIGINS=https://<staging-app-host>
TRUSTED_PROXY_CIDRS=<exact address or range of the staging edge proxy, e.g. 127.0.0.1/32>
# Email: a staging-only sender; never the production SMTP/Resend credential. A sandbox provider is preferred.
EMAIL_DRIVER=SMTP
EMAIL_SMTP_HOST=<staging-smtp-host>
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=<staging-smtp-user>
EMAIL_SMTP_PASSWORD=<staging-smtp-password>
EMAIL_FROM_ADDRESS=<staging sender address>
# Object storage: the staging-only bucket and a key scoped to that bucket only.
S3_BUCKET=<staging-bucket>
S3_REGION=<region-or-auto>
S3_ENDPOINT=https://<s3-compatible-endpoint>
S3_ACCESS_KEY_ID=<staging-bucket-scoped-key-id>
S3_SECRET_ACCESS_KEY=<staging-bucket-scoped-secret>
# Optional
# SENTRY_DSN=<staging-project-dsn>
# APP_VERSION=<release commit>
#
# MUST NOT be in this file: DATABASE_URL, DATABASE_URL_UNPOOLED, DATABASE_DIRECT_URL, DB_POOL_MAX, any libpq PG* variable,
# anything from .env.migrate or .env.ops, DB_TARGET, ALLOW_PRODUCTION_DB_COMMANDS, CREWFLOW_MIGRATION_*,
# CREWFLOW_*_BOOTSTRAP_PASSWORD, CREWFLOW_DEPLOYMENT_IDENTITY_BOOTSTRAP, CREWFLOW_PROVISIONER_DATABASE_URL, BOOTSTRAP_ADMIN_*,
# TEST_*, ALLOW_REMOTE_TEST_DATABASE, HWS_RUNTIME_ENABLED, CREWFLOW_RUNTIME_ISOLATION, WORKSPACE_SUBDOMAIN_ORIGIN_TRUST_ENABLED,
# NODE_OPTIONS.
