# rab-worker environment for STAGING. Template only: copy to ${CREWFLOW_SECRETS_DIR}/worker.env (root:root 0600) and fill
# every <placeholder> from the staging secret store. A complete file: the launcher refuses to start without PG_DATABASE_URL,
# REDIS_URL and CREWFLOW_PROVISIONER_DATABASE_URL. Shared values (database host, identity, budget, Redis, APP_SECRET, URLs,
# email, S3) are the SAME staging values as in api.env. `verify-image-compose.cjs --environment` refuses an unfilled
# placeholder, a missing required name, a migration/ops credential and a login other than the allowed ones.
#
# Jobs child: the restricted runtime login at the DIRECT host. After the approved Phase D readiness step (runbook section 6)
# this same name holds the crewflow_worker URL instead.
PG_DATABASE_URL=postgresql://crewflow_app:<staging-crewflow_app-password>@<staging-db-direct-host>:5432/<staging-db-name>?sslmode=verify-full
PG_SSL_CA_CERT_PATH=/run/crewflow/pg-ca.crt
PG_EXPECTED_DATABASE_NAME=<staging-db-name>
# Provisioner child: the privileged provisioning login (until gate G2), read ONLY by the launcher and handed ONLY to that child.
CREWFLOW_PROVISIONER_DATABASE_URL=postgresql://crewflow:<staging-crewflow-password>@<staging-db-direct-host>:5432/<staging-db-name>?sslmode=verify-full
# Deployment identity (the same staging id as api.env; runbook section 2).
CREWFLOW_DEPLOYMENT_ENVIRONMENT=production
CREWFLOW_DEPLOYMENT_ID=<staging-deployment-uuid>
# Connection budget (the same instance/pool values as api.env; the Worker's own pool is committed: 12).
PG_EXPECTED_API_POOL_MAX=9
PG_EXPECTED_API_INSTANCES=1
PG_EXPECTED_WORKER_INSTANCES=1
PG_EXPECTED_WORKER_POOL_MAX=12
REDIS_URL=redis://crewflow:<staging-redis-app-password>@rab-redis:6379
APP_SECRET=<staging-app-secret>
APP_URL=https://<staging-app-host>
ACCOUNTS_URL=https://<staging-app-host>
CORS_ORIGINS=https://<staging-app-host>
TRUSTED_PROXY_CIDRS=<exact address or range of the staging edge proxy, e.g. 127.0.0.1/32>
EMAIL_DRIVER=SMTP
EMAIL_SMTP_HOST=<staging-smtp-host>
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=<staging-smtp-user>
EMAIL_SMTP_PASSWORD=<staging-smtp-password>
EMAIL_FROM_ADDRESS=<staging sender address>
S3_BUCKET=<staging-bucket>
S3_REGION=<region-or-auto>
S3_ENDPOINT=https://<s3-compatible-endpoint>
S3_ACCESS_KEY_ID=<staging-bucket-scoped-key-id>
S3_SECRET_ACCESS_KEY=<staging-bucket-scoped-secret>
# Optional
# SENTRY_DSN=<staging-project-dsn>
# APP_VERSION=<release commit>
#
# Phase D: WORKER_CLAIM_MODE=global is added only at the approved activation (runbook section 6); never WORKER_DISPATCH_MODE.
#
# MUST NOT be in this file: everything listed at the end of api.env.example, plus CREWFLOW_PROVISIONER_ENABLED (committed
# "true"), NODE_OPTIONS and WORKER_INVITE_AUTO_DELETE_ENABLED.
