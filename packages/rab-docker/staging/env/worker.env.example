# rab-worker environment for STAGING. Template only: copy to ${CREWFLOW_SECRETS_DIR}/worker.env (root:root 0600).
# Everything in api.env.example (the same staging values: database, identity, budget, Redis, APP_SECRET, URLs, email, S3),
# PLUS:
#
# The privileged provisioning login (until gate G2), read ONLY by the launcher and handed ONLY to the provisioner child.
CREWFLOW_PROVISIONER_DATABASE_URL=postgresql://crewflow:<staging-crewflow-password>@<staging-db-direct-host>:5432/<staging-db-name>?sslmode=verify-full
#
# Phase D (only after its own approval, runbook section 6): once crewflow_worker exists and the readiness step is approved,
# the Worker's PG_DATABASE_URL (same name) becomes the crewflow_worker URL; WORKER_CLAIM_MODE=global is added only at the
# approved activation. Until then: PG_DATABASE_URL = the crewflow_app URL, and no WORKER_CLAIM_MODE / WORKER_DISPATCH_MODE.
#
# MUST NOT be in this file: everything listed in api.env.example, plus CREWFLOW_PROVISIONER_ENABLED (committed "true"),
# NODE_OPTIONS and WORKER_INVITE_AUTO_DELETE_ENABLED.
