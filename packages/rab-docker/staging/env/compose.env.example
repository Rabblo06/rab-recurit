# Compose INTERPOLATION values for docker-compose.image.yml + staging/docker-compose.staging.yml on the staging VM.
# Copy to /etc/crewflow-staging/compose.env (root:root 0600). NO SECRET belongs in this file: only image references,
# host paths, the API bind address and resource limits. Pass it with `docker compose --env-file`.
#
# Images: the approved release's multi-platform INDEX digests (amd64 + arm64), never tags. The repositories default to
# the release registry (R1) in docker-compose.image.yml; do not set CREWFLOW_*_IMAGE_REPOSITORY for staging (only the local
# rehearsal overrides them, with locally built images).
CREWFLOW_API_IMAGE_DIGEST=sha256:<api-index-digest-64-hex>
CREWFLOW_WORKER_IMAGE_DIGEST=sha256:<worker-index-digest-64-hex>
# Redis 7.x pinned by digest (record the tag it was resolved from in the release notes).
CREWFLOW_REDIS_IMAGE=redis@sha256:<redis-index-digest-64-hex>
#
# Host paths (absolute).
CREWFLOW_SECRETS_DIR=/etc/crewflow-staging/secrets
CREWFLOW_REDIS_CONF=/opt/crewflow-staging/release/packages/rab-docker/hosting/redis/redis.production.conf
CREWFLOW_PG_CA_FILE=/etc/crewflow-staging/pg-ca.crt
#
# The address the edge proxy connects to (loopback when the proxy runs on the host). Never 0.0.0.0.
CREWFLOW_API_BIND=127.0.0.1
#
# Resource limits (H6 defaults; cpus must not exceed the VM's vCPU count).
CREWFLOW_API_MEM_LIMIT=768m
CREWFLOW_API_CPUS=2
CREWFLOW_WORKER_MEM_LIMIT=1536m
CREWFLOW_WORKER_CPUS=2
